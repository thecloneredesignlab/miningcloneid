-    ) +
-      geom_line()
-  }
+o2 <- read_tsv(input_paths[["o2"]])
+require_columns(
+  o2,
+  c("harvest", "cohort", "day", "o2_target_pct", "o2_eff_pct"),
+  basename(input_paths[["o2"]])
+)
+o2_long <- o2 |>
+  transmute(
+    harvest = factor(harvest, levels = unique(harvest)),
+    day = as.numeric(day),
+    `Target O2` = as.numeric(o2_target_pct),
+    `Latent effective O2` = as.numeric(o2_eff_pct)
+  ) |>
+  pivot_longer(
+    cols = c("Target O2", "Latent effective O2"),
+    names_to = "series",
+    values_to = "o2_pct"
+  )
+
+p_b <- ggplot(o2_long, aes(day, o2_pct, group = harvest)) +
+  # Draw latent first, then target so near-coincident encodings stay visible.
+  geom_line(
+    data = filter(o2_long, series == "Latent effective O2"),
+    colour = blue, linewidth = 0.82
+  ) +
+  geom_line(
+    data = filter(o2_long, series == "Target O2"),
+    colour = orange, linetype = "22", linewidth = 0.62
+  ) +
+  facet_wrap(~ harvest, ncol = 4) +
+  labs(subtitle = "Orange dashed: target; blue: latent model state (not measured)")
