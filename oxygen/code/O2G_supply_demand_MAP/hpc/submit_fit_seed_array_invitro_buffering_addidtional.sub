#!/bin/bash
# Usage:
#   sbatch /share/lab_crd/lab_crd/taoli/Project/Constant_WGD/oxygen/code/O2G_supply_demand_MAP/hpc/submit_fit_seed_array_invitro_buffering_addidtional.sub
#
# This supplemental array reruns only the missing in vitro buffering seeds:
#   470-475 and 492-500

#SBATCH --job-name=o2sd_ivt_B_add
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=22
#SBATCH --mem=32G
#SBATCH --time=7-00:00:00
#SBATCH --array=1-15
#SBATCH --output=/share/lab_crd/lab_crd/taoli/Project/Constant_WGD/oxygen/results/o2sd_ivt_add_%A_%a.out
#SBATCH --error=/share/lab_crd/lab_crd/taoli/Project/Constant_WGD/oxygen/results/o2sd_ivt_add_%A_%a.err

set -euo pipefail

DEFAULT_PROJECT_ROOT="/share/lab_crd/lab_crd/taoli/Project/Constant_WGD"
DEFAULT_RUNNER_SCRIPT="${DEFAULT_PROJECT_ROOT}/oxygen/code/O2G_supply_demand_MAP/runner/run_fit_model_O2G_supply_demand_MAP.sh"
DEFAULT_OUT_ROOT="${DEFAULT_PROJECT_ROOT}/oxygen/results"
DEFAULT_RUN_PREFIX="fit_invitro_O2G_buffering_500seed"
DEFAULT_SEED_LIST="470 471 472 473 474 475 492 493 494 495 496 497 498 499 500"
DEFAULT_N_CORES="${SLURM_CPUS_PER_TASK:-22}"
DEFAULT_R_MODULE="R/4.4"
DEFAULT_MISSEG_LOSS_SURVIVAL="buffering"
DEFAULT_PARAMETER_TABLE="${DEFAULT_PROJECT_ROOT}/oxygen/data/O2G_supply_demand/parameter_table_invitro_buffering.csv"
DEFAULT_FIT_OBJECTS_DIR="${DEFAULT_PROJECT_ROOT}/oxygen/ploidyOxygen/data/fit_objects"
DEFAULT_FLOW_DENSITY_PATH="${DEFAULT_PROJECT_ROOT}/oxygen/data/g0g1_ploidy_density_grid.csv"
DEFAULT_ITERMAX="500"
DEFAULT_DE_RELTOL="1e-4"
DEFAULT_DE_STEPTOL="25"
DEFAULT_NP="80"
DEFAULT_AUTO_VIZ="TRUE"

PROJECT_ROOT="${PROJECT_ROOT:-${DEFAULT_PROJECT_ROOT}}"
RUNNER_SCRIPT="${RUNNER_SCRIPT:-${DEFAULT_RUNNER_SCRIPT}}"
OUT_ROOT="${OUT_ROOT:-${DEFAULT_OUT_ROOT}}"
RUN_PREFIX="${RUN_PREFIX:-${DEFAULT_RUN_PREFIX}}"
SEED_LIST_RAW="${SEED_LIST_RAW:-${DEFAULT_SEED_LIST}}"
N_CORES="${N_CORES:-${DEFAULT_N_CORES}}"
R_MODULE="${R_MODULE:-${DEFAULT_R_MODULE}}"
MISSEG_LOSS_SURVIVAL="${MISSEG_LOSS_SURVIVAL:-${DEFAULT_MISSEG_LOSS_SURVIVAL}}"
PARAMETER_TABLE="${PARAMETER_TABLE:-${DEFAULT_PARAMETER_TABLE}}"
FIT_OBJECTS_DIR="${FIT_OBJECTS_DIR:-${DEFAULT_FIT_OBJECTS_DIR}}"
FLOW_DENSITY_PATH="${FLOW_DENSITY_PATH:-${DEFAULT_FLOW_DENSITY_PATH}}"
ITERMAX="${ITERMAX:-${DEFAULT_ITERMAX}}"
DE_RELTOL="${DE_RELTOL:-${DEFAULT_DE_RELTOL}}"
DE_STEPTOL="${DE_STEPTOL:-${DEFAULT_DE_STEPTOL}}"
NP="${NP:-${DEFAULT_NP}}"
AUTO_VIZ="${AUTO_VIZ:-${DEFAULT_AUTO_VIZ}}"

read -r -a SEED_LIST <<< "${SEED_LIST_RAW}"
ARRAY_TASKS="${#SEED_LIST[@]}"
if (( ARRAY_TASKS == 0 )); then
  echo "SEED_LIST_RAW produced an empty seed list."
  exit 1
fi

if command -v ml >/dev/null 2>&1; then
  ml "${R_MODULE}"
elif command -v module >/dev/null 2>&1; then
  module load "${R_MODULE}"
fi

if ! command -v Rscript >/dev/null 2>&1; then
  echo "Rscript not found after module loading."
  exit 1
fi
if ! Rscript -e 'cat("R module sanity check OK\n")' >/dev/null 2>&1; then
  echo "R module sanity check failed after module loading."
  echo "Loaded modules:"
  if command -v ml >/dev/null 2>&1; then
    ml list 2>&1 || true
  elif command -v module >/dev/null 2>&1; then
    module list 2>&1 || true
  fi
  exit 1
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd)"
RUNNER_SCRIPT="$(cd "$(dirname "${RUNNER_SCRIPT}")" && pwd)/$(basename "${RUNNER_SCRIPT}")"
mkdir -p "${OUT_ROOT}"
OUT_ROOT="$(cd "${OUT_ROOT}" && pwd)"
PARAMETER_TABLE="$(cd "$(dirname "${PARAMETER_TABLE}")" && pwd)/$(basename "${PARAMETER_TABLE}")"
FIT_OBJECTS_DIR="$(cd "${FIT_OBJECTS_DIR}" && pwd)"
FLOW_DENSITY_PATH="$(cd "$(dirname "${FLOW_DENSITY_PATH}")" && pwd)/$(basename "${FLOW_DENSITY_PATH}")"
FLOW_DENSITY_ENABLED="TRUE"

if [[ ! -f "${RUNNER_SCRIPT}" ]]; then
  echo "Missing runner script: ${RUNNER_SCRIPT}"
  exit 1
fi
if [[ ! -f "${PARAMETER_TABLE}" ]]; then
  echo "Missing parameter table: ${PARAMETER_TABLE}"
  exit 1
fi
if [[ ! -d "${FIT_OBJECTS_DIR}" ]]; then
  echo "Missing fit_objects_dir: ${FIT_OBJECTS_DIR}"
  exit 1
fi
if [[ ! -f "${FIT_OBJECTS_DIR}/fit_data.Rds" ]]; then
  echo "Missing fit object file: ${FIT_OBJECTS_DIR}/fit_data.Rds"
  exit 1
fi
if [[ ! -f "${FIT_OBJECTS_DIR}/jobs_2N.Rds" ]]; then
  echo "Missing fit object file: ${FIT_OBJECTS_DIR}/jobs_2N.Rds"
  exit 1
fi
if [[ ! -f "${FIT_OBJECTS_DIR}/jobs_4N.Rds" ]]; then
  echo "Missing fit object file: ${FIT_OBJECTS_DIR}/jobs_4N.Rds"
  exit 1
fi
if [[ ! -f "${FLOW_DENSITY_PATH}" ]]; then
  echo "Flow density file not found; continuing without flow-density input: ${FLOW_DENSITY_PATH}"
  FLOW_DENSITY_ENABLED="FALSE"
fi
FLOW_DENSITY_ARGS=()
if [[ "${FLOW_DENSITY_ENABLED}" == "TRUE" ]]; then
  FLOW_DENSITY_ARGS=(--flow_density_path="${FLOW_DENSITY_PATH}")
fi

for var_name in N_CORES ITERMAX DE_STEPTOL NP; do
  var_val="${!var_name}"
  if ! [[ "${var_val}" =~ ^[0-9]+$ ]]; then
    echo "${var_name} must be a positive integer, got: ${var_val}"
    exit 1
  fi
done

for seed in "${SEED_LIST[@]}"; do
  if ! [[ "${seed}" =~ ^[0-9]+$ ]]; then
    echo "Every seed must be a positive integer, got: ${seed}"
    exit 1
  fi
done

case "${MISSEG_LOSS_SURVIVAL}" in
  nullisomy|buffering|buffer|symmetric_buffering|symmetric-buffering|nullisomy_loss|nullisomy-loss)
    ;;
  *)
    echo "MISSEG_LOSS_SURVIVAL must be one of: nullisomy, buffering"
    exit 1
    ;;
esac

case "${AUTO_VIZ}" in
  TRUE|true|True|1|yes|YES|FALSE|false|False|0|no|NO)
    ;;
  *)
    echo "AUTO_VIZ must be TRUE or FALSE, got: ${AUTO_VIZ}"
    exit 1
    ;;
esac

if ! [[ "${DE_RELTOL}" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$ ]]; then
  echo "DE_RELTOL must be a positive numeric value, got: ${DE_RELTOL}"
  exit 1
fi

if (( N_CORES <= 0 || ITERMAX <= 0 || DE_STEPTOL <= 0 || NP <= 0 )); then
  echo "N_CORES, ITERMAX, DE_STEPTOL, and NP must all be > 0"
  exit 1
fi

if (( ITERMAX > 500 )); then
  echo "ITERMAX=${ITERMAX} exceeds the in vitro maximum of 500; capping to 500."
  ITERMAX="500"
fi

TASK_ID="${SLURM_ARRAY_TASK_ID:-1}"
TASK_COUNT="${SLURM_ARRAY_TASK_COUNT:-${ARRAY_TASKS}}"
if (( TASK_COUNT != ARRAY_TASKS )); then
  echo "This script expects ${ARRAY_TASKS} array tasks, but SLURM reports ${TASK_COUNT}."
  echo "Please submit with --array=1-${ARRAY_TASKS}."
  exit 1
fi
if (( TASK_ID < 1 || TASK_ID > ARRAY_TASKS )); then
  echo "Invalid task id: ${TASK_ID}. Expected 1..${ARRAY_TASKS}."
  exit 1
fi

SEED="${SEED_LIST[$((TASK_ID - 1))]}"
SEEDS_CSV="$(IFS=,; echo "${SEED_LIST[*]}")"

RUN_DIR="${OUT_ROOT}/${RUN_PREFIX}"
mkdir -p "${RUN_DIR}"

MANIFEST_PATH="${RUN_DIR}/fit_array_additional_manifest.tsv"
if [[ ! -f "${MANIFEST_PATH}" ]]; then
  {
    printf "key\tvalue\n"
    printf "project_root\t%s\n" "${PROJECT_ROOT}"
    printf "runner_script\t%s\n" "${RUNNER_SCRIPT}"
    printf "out_root\t%s\n" "${OUT_ROOT}"
    printf "run_prefix\t%s\n" "${RUN_PREFIX}"
    printf "seed_list\t%s\n" "${SEEDS_CSV}"
    printf "array_tasks\t%s\n" "${ARRAY_TASKS}"
    printf "seeds_per_task\t1\n"
    printf "n_cores\t%s\n" "${N_CORES}"
    printf "itermax\t%s\n" "${ITERMAX}"
    printf "de_reltol\t%s\n" "${DE_RELTOL}"
    printf "de_steptol\t%s\n" "${DE_STEPTOL}"
    printf "NP\t%s\n" "${NP}"
    printf "misseg_loss_survival\t%s\n" "${MISSEG_LOSS_SURVIVAL}"
    printf "parameter_table\t%s\n" "${PARAMETER_TABLE}"
    printf "fit_objects_dir\t%s\n" "${FIT_OBJECTS_DIR}"
    printf "flow_density_path\t%s\n" "${FLOW_DENSITY_PATH}"
    printf "flow_density_enabled\t%s\n" "${FLOW_DENSITY_ENABLED}"
    printf "auto_viz\t%s\n" "${AUTO_VIZ}"
    printf "r_module\t%s\n" "${R_MODULE}"
    printf "slurm_array_job_id\t%s\n" "${SLURM_ARRAY_JOB_ID:-NA}"
  } > "${MANIFEST_PATH}"
fi

echo "Starting supplemental in vitro fit array task"
echo "  slurm_array_job_id: ${SLURM_ARRAY_JOB_ID:-NA}"
echo "  task_id: ${TASK_ID}/${ARRAY_TASKS}"
echo "  seed: ${SEED}"
echo "  all_seeds: ${SEEDS_CSV}"
echo "  run_prefix: ${RUN_PREFIX}"
echo "  run_dir: ${RUN_DIR}"
echo "  n_cores: ${N_CORES}"
echo "  itermax: ${ITERMAX}"
echo "  de_reltol: ${DE_RELTOL}"
echo "  de_steptol: ${DE_STEPTOL}"
echo "  NP: ${NP}"
echo "  misseg_loss_survival: ${MISSEG_LOSS_SURVIVAL}"
echo "  parameter_table: ${PARAMETER_TABLE}"
echo "  fit_objects_dir: ${FIT_OBJECTS_DIR}"
echo "  flow_density_path: ${FLOW_DENSITY_PATH}"
echo "  flow_density_enabled: ${FLOW_DENSITY_ENABLED}"
echo "  auto_viz: ${AUTO_VIZ}"
echo "  r_module: ${R_MODULE}"

seed_dir="${RUN_DIR}/seed${SEED}"
mkdir -p "${seed_dir}"
echo "[seed ${SEED}] starting"
bash "${RUNNER_SCRIPT}" \
  --fit_invitro \
  --seed="${SEED}" \
  --itermax="${ITERMAX}" \
  --de_reltol="${DE_RELTOL}" \
  --de_steptol="${DE_STEPTOL}" \
  --NP="${NP}" \
  --n_cores="${N_CORES}" \
  --out_dir="${seed_dir}" \
  --misseg_loss_survival="${MISSEG_LOSS_SURVIVAL}" \
  --parameter_table="${PARAMETER_TABLE}" \
  --fit_objects_dir="${FIT_OBJECTS_DIR}" \
  --auto_viz="${AUTO_VIZ}" \
  "${FLOW_DENSITY_ARGS[@]}"
echo "[seed ${SEED}] completed"

echo "Task ${TASK_ID} completed."
