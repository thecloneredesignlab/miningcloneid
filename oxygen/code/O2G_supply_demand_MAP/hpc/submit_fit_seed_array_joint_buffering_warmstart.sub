#!/bin/bash
# Usage:
#   sbatch /share/lab_crd/lab_crd/taoli/Project/Constant_WGD/oxygen/code/O2G_supply_demand_MAP/hpc/submit_fit_seed_array_joint_buffering_warmstart.sub

#SBATCH --job-name=o2gj_WS
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=22
#SBATCH --mem=32G
#SBATCH --time=7-00:00:00
#SBATCH --array=1-500
#SBATCH --output=/share/lab_crd/lab_crd/taoli/Project/Constant_WGD/oxygen/results/o2g_joint_ws_%A_%a.out
#SBATCH --error=/share/lab_crd/lab_crd/taoli/Project/Constant_WGD/oxygen/results/o2g_joint_ws_%A_%a.err

set -euo pipefail

DEFAULT_PROJECT_ROOT="/share/lab_crd/lab_crd/taoli/Project/Constant_WGD"
DEFAULT_RUNNER_SCRIPT="${DEFAULT_PROJECT_ROOT}/oxygen/code/O2G_supply_demand_MAP/runner/run_fit_joint_model_O2G_supply_demand_MAP.sh"
DEFAULT_CONFIG_PATH="${DEFAULT_PROJECT_ROOT}/oxygen/config/O2G_supply_demand.yaml"
DEFAULT_OUT_ROOT="${DEFAULT_PROJECT_ROOT}/oxygen/results"
DEFAULT_RUN_PREFIX="fit_joint_O2G_buffering_warmstart_500seed"
DEFAULT_TOTAL_SEEDS="500"
DEFAULT_ARRAY_TASKS="500"
DEFAULT_SEEDS_PER_TASK="1"
DEFAULT_N_CORES="${SLURM_CPUS_PER_TASK:-22}"
DEFAULT_AUTO_VIZ="TRUE"
DEFAULT_GLUCOSE="TRUE"
DEFAULT_GLUCOSE_DYNAMIC="FALSE"
DEFAULT_GLUCOSE_STRESS_MODE="coupled_to_O2"
DEFAULT_MISSEG_LOSS_SURVIVAL="buffering"
DEFAULT_JOINT_INIT_CANDIDATES_TSV="${DEFAULT_OUT_ROOT}/${DEFAULT_RUN_PREFIX}/joint_init_candidates.tsv"
DEFAULT_R_MODULE="R/4.4"

PROJECT_ROOT="${PROJECT_ROOT:-${DEFAULT_PROJECT_ROOT}}"
RUNNER_SCRIPT="${RUNNER_SCRIPT:-${DEFAULT_RUNNER_SCRIPT}}"
CONFIG_PATH="${CONFIG_PATH:-${DEFAULT_CONFIG_PATH}}"
OUT_ROOT="${OUT_ROOT:-${DEFAULT_OUT_ROOT}}"
RUN_PREFIX="${RUN_PREFIX:-${DEFAULT_RUN_PREFIX}}"
TOTAL_SEEDS="${TOTAL_SEEDS:-${DEFAULT_TOTAL_SEEDS}}"
ARRAY_TASKS="${ARRAY_TASKS:-${DEFAULT_ARRAY_TASKS}}"
SEEDS_PER_TASK="${SEEDS_PER_TASK:-${DEFAULT_SEEDS_PER_TASK}}"
N_CORES="${N_CORES:-${DEFAULT_N_CORES}}"
AUTO_VIZ="${AUTO_VIZ:-${DEFAULT_AUTO_VIZ}}"
GLUCOSE="${GLUCOSE:-${DEFAULT_GLUCOSE}}"
GLUCOSE_DYNAMIC="${GLUCOSE_DYNAMIC:-${DEFAULT_GLUCOSE_DYNAMIC}}"
GLUCOSE_STRESS_MODE="${GLUCOSE_STRESS_MODE:-${DEFAULT_GLUCOSE_STRESS_MODE}}"
MISSEG_LOSS_SURVIVAL="${MISSEG_LOSS_SURVIVAL:-${DEFAULT_MISSEG_LOSS_SURVIVAL}}"
JOINT_INIT_CANDIDATES_TSV="${JOINT_INIT_CANDIDATES_TSV:-${DEFAULT_JOINT_INIT_CANDIDATES_TSV}}"
R_MODULE="${R_MODULE:-${DEFAULT_R_MODULE}}"

if command -v ml >/dev/null 2>&1; then
  ml "${R_MODULE}"
elif command -v module >/dev/null 2>&1; then
  module load "${R_MODULE}"
fi

if ! command -v Rscript >/dev/null 2>&1; then
  echo "Rscript not found after module loading."
  exit 1
fi
if ! Rscript -e 'cat("R module sanity check OK\n")' >/dev/null 2>&1; then
  echo "R module sanity check failed after module loading."
  echo "Loaded modules:"
  if command -v ml >/dev/null 2>&1; then
    ml list 2>&1 || true
  elif command -v module >/dev/null 2>&1; then
    module list 2>&1 || true
  fi
  exit 1
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd)"
RUNNER_SCRIPT="$(cd "$(dirname "${RUNNER_SCRIPT}")" && pwd)/$(basename "${RUNNER_SCRIPT}")"
CONFIG_PATH="$(cd "$(dirname "${CONFIG_PATH}")" && pwd)/$(basename "${CONFIG_PATH}")"
mkdir -p "${OUT_ROOT}"
OUT_ROOT="$(cd "${OUT_ROOT}" && pwd)"
JOINT_INIT_CANDIDATES_TSV="$(cd "$(dirname "${JOINT_INIT_CANDIDATES_TSV}")" && pwd)/$(basename "${JOINT_INIT_CANDIDATES_TSV}")"

if [[ ! -f "${RUNNER_SCRIPT}" ]]; then
  echo "Missing runner script: ${RUNNER_SCRIPT}"
  exit 1
fi
if [[ ! -f "${CONFIG_PATH}" ]]; then
  echo "Missing config file: ${CONFIG_PATH}"
  exit 1
fi
if [[ ! -f "${JOINT_INIT_CANDIDATES_TSV}" ]]; then
  echo "Missing joint init candidates TSV: ${JOINT_INIT_CANDIDATES_TSV}"
  echo "Run submit_fit_seed_array_joint_buffering_warmstart.sh first, or pass JOINT_INIT_CANDIDATES_TSV."
  exit 1
fi

if ! [[ "${TOTAL_SEEDS}" =~ ^[0-9]+$ ]]; then
  echo "TOTAL_SEEDS must be a positive integer, got: ${TOTAL_SEEDS}"
  exit 1
fi
if ! [[ "${ARRAY_TASKS}" =~ ^[0-9]+$ ]]; then
  echo "ARRAY_TASKS must be a positive integer, got: ${ARRAY_TASKS}"
  exit 1
fi
if ! [[ "${SEEDS_PER_TASK}" =~ ^[0-9]+$ ]]; then
  echo "SEEDS_PER_TASK must be a positive integer, got: ${SEEDS_PER_TASK}"
  exit 1
fi
if ! [[ "${N_CORES}" =~ ^[0-9]+$ ]]; then
  echo "N_CORES must be a positive integer, got: ${N_CORES}"
  exit 1
fi
case "${GLUCOSE_DYNAMIC}" in
  TRUE|FALSE|true|false|T|F|t|f|1|0|yes|no|YES|NO|y|n|Y|N)
    ;;
  *)
    echo "GLUCOSE_DYNAMIC must be TRUE/FALSE, got: ${GLUCOSE_DYNAMIC}"
    exit 1
    ;;
esac
case "${GLUCOSE}" in
  TRUE|FALSE|true|false|T|F|t|f|1|0|yes|no|YES|NO|y|n|Y|N)
    ;;
  *)
    echo "GLUCOSE must be TRUE/FALSE, got: ${GLUCOSE}"
    exit 1
    ;;
esac
case "${GLUCOSE_STRESS_MODE}" in
  off|coupled_to_O2|dynamic)
    ;;
  *)
    echo "GLUCOSE_STRESS_MODE must be off, coupled_to_O2, or dynamic, got: ${GLUCOSE_STRESS_MODE}"
    exit 1
    ;;
esac
case "${MISSEG_LOSS_SURVIVAL}" in
  nullisomy|buffering)
    ;;
  *)
    echo "MISSEG_LOSS_SURVIVAL must be nullisomy or buffering, got: ${MISSEG_LOSS_SURVIVAL}"
    exit 1
    ;;
esac

if (( TOTAL_SEEDS <= 0 || ARRAY_TASKS <= 0 || SEEDS_PER_TASK <= 0 || N_CORES <= 0 )); then
  echo "TOTAL_SEEDS, ARRAY_TASKS, SEEDS_PER_TASK, N_CORES must all be > 0"
  exit 1
fi

if (( ARRAY_TASKS * SEEDS_PER_TASK != TOTAL_SEEDS )); then
  echo "Mismatch: ARRAY_TASKS * SEEDS_PER_TASK must equal TOTAL_SEEDS."
  echo "Got ARRAY_TASKS=${ARRAY_TASKS}, SEEDS_PER_TASK=${SEEDS_PER_TASK}, TOTAL_SEEDS=${TOTAL_SEEDS}."
  exit 1
fi

TASK_ID="${SLURM_ARRAY_TASK_ID:-1}"
TASK_COUNT="${SLURM_ARRAY_TASK_COUNT:-${ARRAY_TASKS}}"
if (( TASK_COUNT != ARRAY_TASKS )); then
  echo "This script expects ${ARRAY_TASKS} array tasks, but SLURM reports ${TASK_COUNT}."
  echo "Please submit with --array=1-${ARRAY_TASKS}."
  exit 1
fi
if (( TASK_ID < 1 || TASK_ID > ARRAY_TASKS )); then
  echo "Invalid task id: ${TASK_ID}. Expected 1..${ARRAY_TASKS}."
  exit 1
fi

SEED_START=$(( (TASK_ID - 1) * SEEDS_PER_TASK + 1 ))
SEED_END=$(( TASK_ID * SEEDS_PER_TASK ))
SEEDS_CSV="$(seq -s, "${SEED_START}" "${SEED_END}")"

RUN_DIR="${OUT_ROOT}/${RUN_PREFIX}"
mkdir -p "${RUN_DIR}"

MANIFEST_PATH="${RUN_DIR}/fit_array_manifest.tsv"
if [[ ! -f "${MANIFEST_PATH}" ]]; then
  {
    printf "key\tvalue\n"
    printf "project_root\t%s\n" "${PROJECT_ROOT}"
    printf "runner_script\t%s\n" "${RUNNER_SCRIPT}"
    printf "config_path\t%s\n" "${CONFIG_PATH}"
    printf "out_root\t%s\n" "${OUT_ROOT}"
    printf "run_prefix\t%s\n" "${RUN_PREFIX}"
    printf "total_seeds\t%s\n" "${TOTAL_SEEDS}"
    printf "array_tasks\t%s\n" "${ARRAY_TASKS}"
    printf "seeds_per_task\t%s\n" "${SEEDS_PER_TASK}"
    printf "n_cores\t%s\n" "${N_CORES}"
    printf "auto_viz\t%s\n" "${AUTO_VIZ}"
    printf "glucose\t%s\n" "${GLUCOSE}"
    printf "glucose_dynamic\t%s\n" "${GLUCOSE_DYNAMIC}"
    printf "glucose_stress_mode\t%s\n" "${GLUCOSE_STRESS_MODE}"
    printf "misseg_loss_survival\t%s\n" "${MISSEG_LOSS_SURVIVAL}"
    printf "joint_init_candidates_tsv\t%s\n" "${JOINT_INIT_CANDIDATES_TSV}"
    printf "r_module\t%s\n" "${R_MODULE}"
    printf "slurm_array_job_id\t%s\n" "${SLURM_ARRAY_JOB_ID:-NA}"
  } > "${MANIFEST_PATH}"
fi

echo "Starting warm-start joint fit array task"
echo "  slurm_array_job_id: ${SLURM_ARRAY_JOB_ID:-NA}"
echo "  task_id: ${TASK_ID}/${ARRAY_TASKS}"
echo "  seeds: ${SEED_START}-${SEED_END}"
echo "  seeds_csv: ${SEEDS_CSV}"
echo "  run_prefix: ${RUN_PREFIX}"
echo "  run_dir: ${RUN_DIR}"
echo "  n_cores: ${N_CORES}"
echo "  auto_viz: ${AUTO_VIZ}"
echo "  glucose: ${GLUCOSE}"
echo "  glucose_dynamic: ${GLUCOSE_DYNAMIC}"
echo "  glucose_stress_mode: ${GLUCOSE_STRESS_MODE}"
echo "  misseg_loss_survival: ${MISSEG_LOSS_SURVIVAL}"
echo "  joint_init_candidates_tsv: ${JOINT_INIT_CANDIDATES_TSV}"
echo "  r_module: ${R_MODULE}"

bash "${RUNNER_SCRIPT}" \
  --mode=run \
  --config="${CONFIG_PATH}" \
  --out_root="${OUT_ROOT}" \
  --run_prefix="${RUN_PREFIX}" \
  --append_run_prefix_timestamp=FALSE \
  --seeds_csv="${SEEDS_CSV}" \
  --n_cores="${N_CORES}" \
  --auto_viz="${AUTO_VIZ}" \
  --glucose="${GLUCOSE}" \
  --glucose_dynamic="${GLUCOSE_DYNAMIC}" \
  --glucose_stress_mode="${GLUCOSE_STRESS_MODE}" \
  --misseg_loss_survival="${MISSEG_LOSS_SURVIVAL}" \
  --joint_init_candidates_tsv="${JOINT_INIT_CANDIDATES_TSV}"

echo "Task ${TASK_ID} completed."
