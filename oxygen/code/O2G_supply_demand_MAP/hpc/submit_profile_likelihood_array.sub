#!/bin/bash
# Usage:
#   sbatch /share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/code/O2G_supply_demand_MAP/hpc/submit_profile_likelihood_array.sub
#
# Optional overrides may still be passed through sbatch, for example:
#   sbatch --export=ALL,OUTPUT_ROOT=/path/to/output_root,MAX_STEPS_PER_DIRECTION=30 \
#     /share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/code/O2G_supply_demand_MAP/hpc/submit_profile_likelihood_array.sub

#SBATCH --job-name=o2sd_profile
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=22
#SBATCH --mem=32G
#SBATCH --time=7-00:00:00
#SBATCH --array=1-19
#SBATCH --output=/share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/results/o2sd_profile_%A_%a.out
#SBATCH --error=/share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/results/o2sd_profile_%A_%a.err

set -euo pipefail

DEFAULT_PROJECT_ROOT="/share/lab_crd/lab_crd/taoli/Project/miningcloneid"
DEFAULT_CONFIG_PATH="${DEFAULT_PROJECT_ROOT}/oxygen/config/O2G_supply_demand.yaml"
DEFAULT_BASELINE_SEED_DIR="${DEFAULT_PROJECT_ROOT}/oxygen/results/fit_invivo_o2_supply_demand_MAP_pmiss_0.5_sigma_burden_0.15/seed167"
DEFAULT_PROFILE_BOUNDS_TABLE="${DEFAULT_BASELINE_SEED_DIR}/parameter_table_input.csv"
DEFAULT_OUTPUT_ROOT="${DEFAULT_PROJECT_ROOT}/oxygen/results/profile_likelihood_O2G_supply_demand_MAP_${SLURM_ARRAY_JOB_ID:-manual}"
DEFAULT_MAX_STEPS_PER_DIRECTION="20"
DEFAULT_SEEDS_PER_STEP="20"
DEFAULT_TARGET_DELTA_OBJECTIVE="0.2"
DEFAULT_CI_DELTA_THRESHOLD="1.92"
DEFAULT_STEP_FRACTION_INITIAL="0.10"
DEFAULT_STEP_FRACTION_MIN="1e-6"
DEFAULT_STEP_FRACTION_MAX="0.30"
DEFAULT_MIN_INTERIOR_POINTS_PER_DIRECTION="4"
DEFAULT_CI_REFINE_TOLERANCE="0.05"
DEFAULT_MAX_REFINE_STEPS_CI="6"
DEFAULT_MAX_REFINE_STEPS_BOUNDARY="4"
DEFAULT_BOUNDARY_REFINE_FRACTION_MIN="0.01"
DEFAULT_MAX_STEP_GROWTH_FACTOR="1.5"
DEFAULT_MAX_STEP_SHRINK_FACTOR="0.67"
DEFAULT_BOUNDARY_START_TOLERANCE="1e-8"
DEFAULT_MAX_ATTEMPTS_PER_STEP="5"
DEFAULT_USE_SOFT_PRIOR_FOR_PROFILE="TRUE"
DEFAULT_LAMBDA_PRIOR_FOR_PROFILE="0.03"
DEFAULT_R_MODULE="R/4.4"

PROJECT_ROOT="${PROJECT_ROOT:-${DEFAULT_PROJECT_ROOT}}"
CONFIG_PATH="${CONFIG_PATH:-${DEFAULT_CONFIG_PATH}}"
BASELINE_SEED_DIR="${BASELINE_SEED_DIR:-${DEFAULT_BASELINE_SEED_DIR}}"
PROFILE_BOUNDS_TABLE="${PROFILE_BOUNDS_TABLE:-${DEFAULT_PROFILE_BOUNDS_TABLE}}"
OUTPUT_ROOT="${OUTPUT_ROOT:-${DEFAULT_OUTPUT_ROOT}}"
MAX_STEPS_PER_DIRECTION="${MAX_STEPS_PER_DIRECTION:-${DEFAULT_MAX_STEPS_PER_DIRECTION}}"
SEEDS_PER_STEP="${SEEDS_PER_STEP:-${DEFAULT_SEEDS_PER_STEP}}"
N_CORES="${N_CORES:-${SLURM_CPUS_PER_TASK:-62}}"
TARGET_DELTA_OBJECTIVE="${TARGET_DELTA_OBJECTIVE:-${DEFAULT_TARGET_DELTA_OBJECTIVE}}"
CI_DELTA_THRESHOLD="${CI_DELTA_THRESHOLD:-${DEFAULT_CI_DELTA_THRESHOLD}}"
STEP_FRACTION_INITIAL="${STEP_FRACTION_INITIAL:-${DEFAULT_STEP_FRACTION_INITIAL}}"
STEP_FRACTION_MIN="${STEP_FRACTION_MIN:-${DEFAULT_STEP_FRACTION_MIN}}"
STEP_FRACTION_MAX="${STEP_FRACTION_MAX:-${DEFAULT_STEP_FRACTION_MAX}}"
MIN_INTERIOR_POINTS_PER_DIRECTION="${MIN_INTERIOR_POINTS_PER_DIRECTION:-${DEFAULT_MIN_INTERIOR_POINTS_PER_DIRECTION}}"
CI_REFINE_TOLERANCE="${CI_REFINE_TOLERANCE:-${DEFAULT_CI_REFINE_TOLERANCE}}"
MAX_REFINE_STEPS_CI="${MAX_REFINE_STEPS_CI:-${DEFAULT_MAX_REFINE_STEPS_CI}}"
MAX_REFINE_STEPS_BOUNDARY="${MAX_REFINE_STEPS_BOUNDARY:-${DEFAULT_MAX_REFINE_STEPS_BOUNDARY}}"
BOUNDARY_REFINE_FRACTION_MIN="${BOUNDARY_REFINE_FRACTION_MIN:-${DEFAULT_BOUNDARY_REFINE_FRACTION_MIN}}"
MAX_STEP_GROWTH_FACTOR="${MAX_STEP_GROWTH_FACTOR:-${DEFAULT_MAX_STEP_GROWTH_FACTOR}}"
MAX_STEP_SHRINK_FACTOR="${MAX_STEP_SHRINK_FACTOR:-${DEFAULT_MAX_STEP_SHRINK_FACTOR}}"
BOUNDARY_START_TOLERANCE="${BOUNDARY_START_TOLERANCE:-${DEFAULT_BOUNDARY_START_TOLERANCE}}"
MAX_ATTEMPTS_PER_STEP="${MAX_ATTEMPTS_PER_STEP:-${DEFAULT_MAX_ATTEMPTS_PER_STEP}}"
USE_SOFT_PRIOR_FOR_PROFILE="${USE_SOFT_PRIOR_FOR_PROFILE:-${DEFAULT_USE_SOFT_PRIOR_FOR_PROFILE}}"
LAMBDA_PRIOR_FOR_PROFILE="${LAMBDA_PRIOR_FOR_PROFILE:-${DEFAULT_LAMBDA_PRIOR_FOR_PROFILE}}"
R_MODULE="${R_MODULE:-${DEFAULT_R_MODULE}}"

if command -v ml >/dev/null 2>&1; then
  ml "${R_MODULE}"
elif command -v module >/dev/null 2>&1; then
  module load "${R_MODULE}"
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd)"
CONFIG_PATH="$(cd "$(dirname "${CONFIG_PATH}")" && pwd)/$(basename "${CONFIG_PATH}")"
BASELINE_SEED_DIR="$(cd "${BASELINE_SEED_DIR}" && pwd)"
PROFILE_BOUNDS_TABLE="$(cd "$(dirname "${PROFILE_BOUNDS_TABLE}")" && pwd)/$(basename "${PROFILE_BOUNDS_TABLE}")"
mkdir -p "${OUTPUT_ROOT}"
OUTPUT_ROOT="$(cd "${OUTPUT_ROOT}" && pwd)"

if [[ ! -f "${CONFIG_PATH}" ]]; then
  echo "Missing config file: ${CONFIG_PATH}"
  exit 1
fi
if [[ ! -d "${BASELINE_SEED_DIR}" ]]; then
  echo "Missing baseline seed directory: ${BASELINE_SEED_DIR}"
  exit 1
fi
if [[ ! -f "${PROFILE_BOUNDS_TABLE}" ]]; then
  echo "Missing profile bounds table: ${PROFILE_BOUNDS_TABLE}"
  exit 1
fi

WORKFLOW_ROOT="${PROJECT_ROOT}/oxygen/code/O2G_supply_demand_MAP"
JOB_SCRIPT="${WORKFLOW_ROOT}/optimizer/profile_likelihood_O2G_supply_demand_MAP.R"
if [[ ! -f "${JOB_SCRIPT}" ]]; then
  echo "Missing profile likelihood job script: ${JOB_SCRIPT}"
  exit 1
fi

PARAM_TARGETS_TSV="${OUTPUT_ROOT}/parameter_targets.tsv"
if [[ ! -f "${PARAM_TARGETS_TSV}" ]]; then
  Rscript -e 'args <- commandArgs(TRUE); tab <- read.csv(args[1], stringsAsFactors = FALSE, check.names = FALSE); out <- args[2]; est <- tolower(trimws(as.character(tab$estimate))); keep <- est %in% c("true","t","1","yes","y"); target <- data.frame(param_index = seq_len(sum(keep)), param_symbol = as.character(tab$param_symbol[keep]), stringsAsFactors = FALSE); write.table(target, file = out, sep = "\t", quote = FALSE, row.names = FALSE, col.names = TRUE)' \
    "${PROFILE_BOUNDS_TABLE}" "${PARAM_TARGETS_TSV}"
fi

PARAM_COUNT="$(Rscript -e 'args <- commandArgs(TRUE); tab <- read.delim(args[1], stringsAsFactors = FALSE, check.names = FALSE); cat(nrow(tab), "\n", sep = "")' "${PARAM_TARGETS_TSV}")"
ARRAY_TASK_COUNT="${SLURM_ARRAY_TASK_COUNT:-1}"
PARAM_INDEX="${SLURM_ARRAY_TASK_ID:-1}"

if [[ -z "${PARAM_COUNT}" || "${PARAM_COUNT}" -lt 1 ]]; then
  echo "No parameter targets were generated in ${PARAM_TARGETS_TSV}"
  exit 1
fi

if (( PARAM_COUNT > ARRAY_TASK_COUNT )); then
  echo "Array task count (${ARRAY_TASK_COUNT}) is smaller than parameter target count (${PARAM_COUNT})."
  echo "Please submit with an array covering all targets, for example --array=1-${PARAM_COUNT}."
  exit 1
fi

if (( PARAM_INDEX > PARAM_COUNT )); then
  echo "Skipping task ${PARAM_INDEX}: only ${PARAM_COUNT} parameter targets were found."
  exit 0
fi

PARAM_NAME="$(awk -F'\t' -v idx="${PARAM_INDEX}" 'NR > 1 && $1 == idx { print $2; exit }' "${PARAM_TARGETS_TSV}")"

MANIFEST_PATH="${OUTPUT_ROOT}/submission_manifest.tsv"
if [[ ! -f "${MANIFEST_PATH}" ]]; then
  {
    printf "key\tvalue\n"
    printf "project_root\t%s\n" "${PROJECT_ROOT}"
    printf "config_path\t%s\n" "${CONFIG_PATH}"
    printf "baseline_seed_dir\t%s\n" "${BASELINE_SEED_DIR}"
    printf "profile_bounds_table\t%s\n" "${PROFILE_BOUNDS_TABLE}"
    printf "output_root\t%s\n" "${OUTPUT_ROOT}"
    printf "parameter_count\t%s\n" "${PARAM_COUNT}"
    printf "slurm_array_task_count\t%s\n" "${ARRAY_TASK_COUNT}"
    printf "max_steps_per_direction\t%s\n" "${MAX_STEPS_PER_DIRECTION}"
    printf "seeds_per_step\t%s\n" "${SEEDS_PER_STEP}"
    printf "n_cores\t%s\n" "${N_CORES}"
    printf "target_delta_objective\t%s\n" "${TARGET_DELTA_OBJECTIVE}"
    printf "ci_delta_threshold\t%s\n" "${CI_DELTA_THRESHOLD}"
    printf "step_fraction_initial\t%s\n" "${STEP_FRACTION_INITIAL}"
    printf "step_fraction_min\t%s\n" "${STEP_FRACTION_MIN}"
    printf "step_fraction_max\t%s\n" "${STEP_FRACTION_MAX}"
    printf "min_interior_points_per_direction\t%s\n" "${MIN_INTERIOR_POINTS_PER_DIRECTION}"
    printf "ci_refine_tolerance\t%s\n" "${CI_REFINE_TOLERANCE}"
    printf "max_refine_steps_ci\t%s\n" "${MAX_REFINE_STEPS_CI}"
    printf "max_refine_steps_boundary\t%s\n" "${MAX_REFINE_STEPS_BOUNDARY}"
    printf "boundary_refine_fraction_min\t%s\n" "${BOUNDARY_REFINE_FRACTION_MIN}"
    printf "max_step_growth_factor\t%s\n" "${MAX_STEP_GROWTH_FACTOR}"
    printf "max_step_shrink_factor\t%s\n" "${MAX_STEP_SHRINK_FACTOR}"
    printf "boundary_start_tolerance\t%s\n" "${BOUNDARY_START_TOLERANCE}"
    printf "max_attempts_per_step\t%s\n" "${MAX_ATTEMPTS_PER_STEP}"
    printf "use_soft_prior_for_profile\t%s\n" "${USE_SOFT_PRIOR_FOR_PROFILE}"
    printf "lambda_prior_for_profile\t%s\n" "${LAMBDA_PRIOR_FOR_PROFILE}"
    printf "r_module\t%s\n" "${R_MODULE}"
  } > "${MANIFEST_PATH}"
fi

echo "Starting supplement-style profile likelihood task"
echo "  param_index: ${PARAM_INDEX}"
echo "  param_name: ${PARAM_NAME:-unknown}"
echo "  output_root: ${OUTPUT_ROOT}"
echo "  max_steps_per_direction: ${MAX_STEPS_PER_DIRECTION}"
echo "  seeds_per_step: ${SEEDS_PER_STEP}"
echo "  n_cores: ${N_CORES}"
echo "  min_interior_points_per_direction: ${MIN_INTERIOR_POINTS_PER_DIRECTION}"
echo "  ci_refine_tolerance: ${CI_REFINE_TOLERANCE}"
echo "  max_refine_steps_ci: ${MAX_REFINE_STEPS_CI}"
echo "  max_refine_steps_boundary: ${MAX_REFINE_STEPS_BOUNDARY}"
echo "  boundary_refine_fraction_min: ${BOUNDARY_REFINE_FRACTION_MIN}"
echo "  max_step_growth_factor: ${MAX_STEP_GROWTH_FACTOR}"
echo "  max_step_shrink_factor: ${MAX_STEP_SHRINK_FACTOR}"

Rscript "${JOB_SCRIPT}" \
  --config="${CONFIG_PATH}" \
  --baseline_seed_dir="${BASELINE_SEED_DIR}" \
  --profile_bounds_table="${PROFILE_BOUNDS_TABLE}" \
  --output_root="${OUTPUT_ROOT}" \
  --param_index="${PARAM_INDEX}" \
  --max_steps_per_direction="${MAX_STEPS_PER_DIRECTION}" \
  --seeds_per_step="${SEEDS_PER_STEP}" \
  --n_cores="${N_CORES}" \
  --target_delta_objective="${TARGET_DELTA_OBJECTIVE}" \
  --ci_delta_threshold="${CI_DELTA_THRESHOLD}" \
  --step_fraction_initial="${STEP_FRACTION_INITIAL}" \
  --step_fraction_min="${STEP_FRACTION_MIN}" \
  --step_fraction_max="${STEP_FRACTION_MAX}" \
  --min_interior_points_per_direction="${MIN_INTERIOR_POINTS_PER_DIRECTION}" \
  --ci_refine_tolerance="${CI_REFINE_TOLERANCE}" \
  --max_refine_steps_ci="${MAX_REFINE_STEPS_CI}" \
  --max_refine_steps_boundary="${MAX_REFINE_STEPS_BOUNDARY}" \
  --boundary_refine_fraction_min="${BOUNDARY_REFINE_FRACTION_MIN}" \
  --max_step_growth_factor="${MAX_STEP_GROWTH_FACTOR}" \
  --max_step_shrink_factor="${MAX_STEP_SHRINK_FACTOR}" \
  --boundary_start_tolerance="${BOUNDARY_START_TOLERANCE}" \
  --max_attempts_per_step="${MAX_ATTEMPTS_PER_STEP}" \
  --use_soft_prior_for_profile="${USE_SOFT_PRIOR_FOR_PROFILE}" \
  --lambda_prior_for_profile="${LAMBDA_PRIOR_FOR_PROFILE}"
