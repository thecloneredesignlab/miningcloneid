#!/bin/bash
# Usage:
#   sbatch oxygen/code/O2_supply_demand_MAP/Docker/hpc/array_workers/submit_fit_seed_array_joint_buffering.sub
#
# Optional overrides (example):
#   sbatch --export=ALL,RUN_PREFIX=fit_joint_O2_buffering_batch01,OUT_ROOT=/share/.../oxygen/results \
#     /share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/code/O2_supply_demand_MAP/Docker/hpc/array_workers/submit_fit_seed_array_joint_buffering.sub

#SBATCH --job-name=o2j_B
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=22
#SBATCH --mem=32G
#SBATCH --qos=xxlarge
#SBATCH --time=12:00:00
#SBATCH --array=1-500
#SBATCH --output=/share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/results/log/o2_joint_fit_%A_%a.out
#SBATCH --error=/share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/results/log/o2_joint_fit_%A_%a.err

set -euo pipefail

O2SD_DOCKER_HPC_ROOT="${O2SD_DOCKER_HPC_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../util/o2_supply_demand_map_apptainer_runtime.sh
source "${O2SD_DOCKER_HPC_ROOT}/util/o2_supply_demand_map_apptainer_runtime.sh"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
DEFAULT_PROJECT_ROOT="$(cd "${WORKFLOW_ROOT}/../../.." && pwd)"
DEFAULT_RUNNER_SCRIPT="${DEFAULT_PROJECT_ROOT}/oxygen/code/O2_supply_demand_MAP/runner/run_fit_joint_model_O2_supply_demand_MAP.sh"
DEFAULT_CONFIG_PATH="${DEFAULT_PROJECT_ROOT}/oxygen/config/O2_supply_demand.yaml"
DEFAULT_OUT_ROOT="${DEFAULT_PROJECT_ROOT}/oxygen/results"
DEFAULT_RUN_PREFIX="fit_joint_O2_buffering_500seed"
DEFAULT_TOTAL_SEEDS="500"
DEFAULT_ARRAY_TASKS="500"
DEFAULT_SEEDS_PER_TASK="1"
DEFAULT_N_CORES="${SLURM_CPUS_PER_TASK:-22}"
DEFAULT_AUTO_VIZ="TRUE"
DEFAULT_R_MODULE="R/4.4"
DEFAULT_PARAMETER_TABLE="${DEFAULT_PROJECT_ROOT}/oxygen/data/O2_supply_demand/parameter_table_invitro_buffering.csv"
DEFAULT_FIT_OBJECTS_DIR="${DEFAULT_PROJECT_ROOT}/oxygen/ploidyOxygen/data/fit_objects"
DEFAULT_FLOW_DENSITY_PATH="${DEFAULT_PROJECT_ROOT}/oxygen/data/g0g1_ploidy_density_grid.csv"
DEFAULT_ITERMAX="1000"
DEFAULT_DE_RELTOL="1e-4"
DEFAULT_DE_STEPTOL="25"
DEFAULT_NP="80"
DEFAULT_JOINT_WARMUP_ENABLE="FALSE"
DEFAULT_JOINT_WARMUP_SEED_LABEL=""
DEFAULT_JOINT_WARMUP_SIGMAN=""
DEFAULT_JOINT_SOFT_COUPLING_SIGMA_DEFAULT=""
DEFAULT_JOINT_SOFT_COUPLING_WELSCH_C=""
DEFAULT_JOINT_SOFT_COUPLING_PARAMETERS_TABLE=""

PROJECT_ROOT="${PROJECT_ROOT:-${DEFAULT_PROJECT_ROOT}}"
RUNNER_SCRIPT="${RUNNER_SCRIPT:-${DEFAULT_RUNNER_SCRIPT}}"
CONFIG_PATH="${CONFIG_PATH:-${DEFAULT_CONFIG_PATH}}"
OUT_ROOT="${OUT_ROOT:-${DEFAULT_OUT_ROOT}}"
RUN_PREFIX="${RUN_PREFIX:-${DEFAULT_RUN_PREFIX}}"
TOTAL_SEEDS="${TOTAL_SEEDS:-${DEFAULT_TOTAL_SEEDS}}"
ARRAY_TASKS="${ARRAY_TASKS:-${DEFAULT_ARRAY_TASKS}}"
SEEDS_PER_TASK="${SEEDS_PER_TASK:-${DEFAULT_SEEDS_PER_TASK}}"
N_CORES="${N_CORES:-${DEFAULT_N_CORES}}"
AUTO_VIZ="${AUTO_VIZ:-${DEFAULT_AUTO_VIZ}}"
R_MODULE="${R_MODULE:-${DEFAULT_R_MODULE}}"
PARAMETER_TABLE="${PARAMETER_TABLE:-${DEFAULT_PARAMETER_TABLE}}"
FIT_OBJECTS_DIR="${FIT_OBJECTS_DIR:-${DEFAULT_FIT_OBJECTS_DIR}}"
FLOW_DENSITY_PATH="${FLOW_DENSITY_PATH:-${DEFAULT_FLOW_DENSITY_PATH}}"
ITERMAX="${ITERMAX:-${DEFAULT_ITERMAX}}"
DE_RELTOL="${DE_RELTOL:-${DEFAULT_DE_RELTOL}}"
DE_STEPTOL="${DE_STEPTOL:-${DEFAULT_DE_STEPTOL}}"
NP="${NP:-${DEFAULT_NP}}"
JOINT_WARMUP_ENABLE="${JOINT_WARMUP_ENABLE:-${DEFAULT_JOINT_WARMUP_ENABLE}}"
JOINT_WARMUP_SEED_LABEL="${JOINT_WARMUP_SEED_LABEL:-${DEFAULT_JOINT_WARMUP_SEED_LABEL}}"
JOINT_WARMUP_INVIVO_SEED_DIR="${JOINT_WARMUP_INVIVO_SEED_DIR:-}"
JOINT_WARMUP_INVITRO_SEED_DIR="${JOINT_WARMUP_INVITRO_SEED_DIR:-}"
JOINT_WARMUP_SIGMAN="${JOINT_WARMUP_SIGMAN:-${DEFAULT_JOINT_WARMUP_SIGMAN}}"
JOINT_SOFT_COUPLING_SIGMA_DEFAULT="${JOINT_SOFT_COUPLING_SIGMA_DEFAULT:-${DEFAULT_JOINT_SOFT_COUPLING_SIGMA_DEFAULT}}"
JOINT_SOFT_COUPLING_WELSCH_C="${JOINT_SOFT_COUPLING_WELSCH_C:-${DEFAULT_JOINT_SOFT_COUPLING_WELSCH_C}}"
JOINT_SOFT_COUPLING_PARAMETERS_TABLE="${JOINT_SOFT_COUPLING_PARAMETERS_TABLE:-${DEFAULT_JOINT_SOFT_COUPLING_PARAMETERS_TABLE}}"

o2sd_container_ignore_r_module "${R_MODULE}"

if ! command -v Rscript >/dev/null 2>&1; then
  echo "Container-backed Rscript not found."
  exit 1
fi
if ! Rscript -e 'cat("Container R sanity check OK\n")' >/dev/null 2>&1; then
  echo "Container R sanity check failed."
  echo "SIF: ${O2SD_CONTAINER_IMAGE}"
  exit 1
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd)"
RUNNER_SCRIPT="$(cd "$(dirname "${RUNNER_SCRIPT}")" && pwd)/$(basename "${RUNNER_SCRIPT}")"
CONFIG_PATH="$(cd "$(dirname "${CONFIG_PATH}")" && pwd)/$(basename "${CONFIG_PATH}")"
mkdir -p "${OUT_ROOT}"
OUT_ROOT="$(cd "${OUT_ROOT}" && pwd)"
PARAMETER_TABLE="$(cd "$(dirname "${PARAMETER_TABLE}")" && pwd)/$(basename "${PARAMETER_TABLE}")"
FIT_OBJECTS_DIR="$(cd "${FIT_OBJECTS_DIR}" && pwd)"
FLOW_DENSITY_PATH="$(cd "$(dirname "${FLOW_DENSITY_PATH}")" && pwd)/$(basename "${FLOW_DENSITY_PATH}")"
FLOW_DENSITY_ENABLED="TRUE"
PROVENANCE_HELPER="${PROJECT_ROOT}/oxygen/code/O2_supply_demand_MAP/util/o2_supply_demand_map_shell_utils.sh"
if [[ -f "${PROVENANCE_HELPER}" ]]; then
  # shellcheck source=/dev/null
  source "${PROVENANCE_HELPER}"
else
  echo "Missing provenance helper: ${PROVENANCE_HELPER}"
  exit 1
fi

if [[ ! -f "${RUNNER_SCRIPT}" ]]; then
  echo "Missing runner script: ${RUNNER_SCRIPT}"
  exit 1
fi
if [[ ! -f "${CONFIG_PATH}" ]]; then
  echo "Missing config file: ${CONFIG_PATH}"
  exit 1
fi
if [[ ! -f "${PARAMETER_TABLE}" ]]; then
  echo "Missing in vitro parameter table: ${PARAMETER_TABLE}"
  exit 1
fi
if [[ ! -d "${FIT_OBJECTS_DIR}" ]]; then
  echo "Missing fit_objects_dir: ${FIT_OBJECTS_DIR}"
  exit 1
fi
if [[ ! -f "${FIT_OBJECTS_DIR}/fit_data.Rds" ]]; then
  echo "Missing fit object file: ${FIT_OBJECTS_DIR}/fit_data.Rds"
  exit 1
fi
if [[ ! -f "${FIT_OBJECTS_DIR}/jobs_2N.Rds" ]]; then
  echo "Missing fit object file: ${FIT_OBJECTS_DIR}/jobs_2N.Rds"
  exit 1
fi
if [[ ! -f "${FIT_OBJECTS_DIR}/jobs_4N.Rds" ]]; then
  echo "Missing fit object file: ${FIT_OBJECTS_DIR}/jobs_4N.Rds"
  exit 1
fi
if [[ ! -f "${FLOW_DENSITY_PATH}" ]]; then
  echo "Flow density file not found; continuing without flow-density input: ${FLOW_DENSITY_PATH}"
  FLOW_DENSITY_ENABLED="FALSE"
fi
FLOW_DENSITY_ARGS=()
if [[ "${FLOW_DENSITY_ENABLED}" == "TRUE" ]]; then
  FLOW_DENSITY_ARGS=(--flow_density_path="${FLOW_DENSITY_PATH}")
fi
JOINT_WARMUP_ARGS=()

for var_name in TOTAL_SEEDS ARRAY_TASKS SEEDS_PER_TASK N_CORES ITERMAX DE_STEPTOL NP; do
  var_val="${!var_name}"
  if ! [[ "${var_val}" =~ ^[0-9]+$ ]]; then
    echo "${var_name} must be a positive integer, got: ${var_val}"
    exit 1
  fi
done
case "${AUTO_VIZ}" in
  TRUE|FALSE|true|false|T|F|t|f|1|0|yes|no|YES|NO|y|n|Y|N)
    ;;
  *)
    echo "AUTO_VIZ must be TRUE/FALSE, got: ${AUTO_VIZ}"
    exit 1
    ;;
esac
case "${JOINT_WARMUP_ENABLE}" in
  TRUE|FALSE|true|false|T|F|t|f|1|0|yes|no|YES|NO|y|n|Y|N)
    ;;
  *)
    echo "JOINT_WARMUP_ENABLE must be TRUE/FALSE, got: ${JOINT_WARMUP_ENABLE}"
    exit 1
    ;;
esac
if ! [[ "${DE_RELTOL}" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$ ]]; then
  echo "DE_RELTOL must be a positive numeric value, got: ${DE_RELTOL}"
  exit 1
fi
if [[ -n "${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}" ]] && ! [[ "${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$ ]]; then
  echo "JOINT_SOFT_COUPLING_SIGMA_DEFAULT must be a positive numeric value, got: ${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}"
  exit 1
fi
if [[ -n "${JOINT_SOFT_COUPLING_WELSCH_C}" ]] &&
  { ! [[ "${JOINT_SOFT_COUPLING_WELSCH_C}" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$ ]] ||
    ! awk -v x="${JOINT_SOFT_COUPLING_WELSCH_C}" 'BEGIN { exit !(x + 0 > 0) }'; }; then
  echo "JOINT_SOFT_COUPLING_WELSCH_C must be a positive numeric value, got: ${JOINT_SOFT_COUPLING_WELSCH_C}"
  exit 1
fi
if (( TOTAL_SEEDS <= 0 || ARRAY_TASKS <= 0 || SEEDS_PER_TASK <= 0 || N_CORES <= 0 || ITERMAX <= 0 || DE_STEPTOL <= 0 || NP <= 0 )); then
  echo "TOTAL_SEEDS, ARRAY_TASKS, SEEDS_PER_TASK, N_CORES, ITERMAX, DE_STEPTOL, and NP must all be > 0"
  exit 1
fi

if (( ARRAY_TASKS * SEEDS_PER_TASK != TOTAL_SEEDS )); then
  echo "Mismatch: ARRAY_TASKS * SEEDS_PER_TASK must equal TOTAL_SEEDS."
  echo "Got ARRAY_TASKS=${ARRAY_TASKS}, SEEDS_PER_TASK=${SEEDS_PER_TASK}, TOTAL_SEEDS=${TOTAL_SEEDS}."
  exit 1
fi

if [[ -n "${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}" ]]; then
  JOINT_WARMUP_ARGS+=("--joint_soft_coupling_sigma_default=${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}")
fi
if [[ -n "${JOINT_SOFT_COUPLING_WELSCH_C}" ]]; then
  JOINT_WARMUP_ARGS+=("--joint_soft_coupling_welsch_c=${JOINT_SOFT_COUPLING_WELSCH_C}")
fi

case "${JOINT_WARMUP_ENABLE}" in
  TRUE|true|True|1|yes|YES|y|Y|on|ON)
    if [[ -z "${JOINT_WARMUP_INVIVO_SEED_DIR}" || -z "${JOINT_WARMUP_INVITRO_SEED_DIR}" ]]; then
      echo "JOINT_WARMUP_ENABLE=TRUE requires JOINT_WARMUP_INVIVO_SEED_DIR and JOINT_WARMUP_INVITRO_SEED_DIR."
      exit 1
    fi
    if [[ ! -d "${JOINT_WARMUP_INVIVO_SEED_DIR}" ]]; then
      echo "Missing joint warm-up in vivo seed dir: ${JOINT_WARMUP_INVIVO_SEED_DIR}"
      exit 1
    fi
    if [[ ! -d "${JOINT_WARMUP_INVITRO_SEED_DIR}" ]]; then
      echo "Missing joint warm-up in vitro seed dir: ${JOINT_WARMUP_INVITRO_SEED_DIR}"
      exit 1
    fi
    JOINT_WARMUP_INVIVO_SEED_DIR="$(cd "${JOINT_WARMUP_INVIVO_SEED_DIR}" && pwd)"
    JOINT_WARMUP_INVITRO_SEED_DIR="$(cd "${JOINT_WARMUP_INVITRO_SEED_DIR}" && pwd)"
    if [[ -z "${JOINT_WARMUP_SEED_LABEL}" ]]; then
      JOINT_WARMUP_SEED_LABEL="invivo_$(basename "${JOINT_WARMUP_INVIVO_SEED_DIR}")__invitro_$(basename "${JOINT_WARMUP_INVITRO_SEED_DIR}")"
    fi
    JOINT_WARMUP_ARGS+=(
      "--joint_warmup_enable=TRUE"
      "--joint_warmup_seed_label=${JOINT_WARMUP_SEED_LABEL}"
      "--joint_warmup_invivo_seed_dir=${JOINT_WARMUP_INVIVO_SEED_DIR}"
      "--joint_warmup_invitro_seed_dir=${JOINT_WARMUP_INVITRO_SEED_DIR}"
    )
    if [[ -n "${JOINT_WARMUP_SIGMAN}" ]]; then
      JOINT_WARMUP_ARGS+=("--joint_warmup_sigmaN=${JOINT_WARMUP_SIGMAN}")
    fi
    ;;
  *)
    JOINT_WARMUP_ARGS+=("--joint_warmup_enable=FALSE")
    ;;
esac

if [[ -n "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}" ]]; then
  JOINT_SOFT_COUPLING_PARAMETERS_TABLE_DIR="$(dirname "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}")"
  if [[ ! -d "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE_DIR}" ]]; then
    echo "Missing joint soft-coupling start table directory: ${JOINT_SOFT_COUPLING_PARAMETERS_TABLE_DIR}"
    echo "Missing joint soft-coupling start table: ${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}"
    exit 1
  fi
  JOINT_SOFT_COUPLING_PARAMETERS_TABLE="$(cd "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE_DIR}" && pwd)/$(basename "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}")"
  if [[ ! -f "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}" ]]; then
    echo "Missing joint soft-coupling start table: ${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}"
    exit 1
  fi
  JOINT_WARMUP_ARGS+=("--joint_soft_coupling_parameters_table=${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}")
fi

TASK_ID="${SLURM_ARRAY_TASK_ID:-1}"
TASK_COUNT="${SLURM_ARRAY_TASK_COUNT:-${ARRAY_TASKS}}"
if (( TASK_COUNT != ARRAY_TASKS )); then
  echo "This script expects ${ARRAY_TASKS} array tasks, but SLURM reports ${TASK_COUNT}."
  echo "Please submit with --array=1-${ARRAY_TASKS}."
  exit 1
fi
if (( TASK_ID < 1 || TASK_ID > ARRAY_TASKS )); then
  echo "Invalid task id: ${TASK_ID}. Expected 1..${ARRAY_TASKS}."
  exit 1
fi

SEED_START=$(( (TASK_ID - 1) * SEEDS_PER_TASK + 1 ))
SEED_END=$(( TASK_ID * SEEDS_PER_TASK ))
SEEDS_CSV="$(seq -s, "${SEED_START}" "${SEED_END}")"

RUN_DIR="${OUT_ROOT}/${RUN_PREFIX}"
mkdir -p "${RUN_DIR}"
o2sd_prov_write_standard "${RUN_DIR}" "${BASH_SOURCE[0]}" "${O2SD_RUN_COMMAND:-}"
o2sd_prov_write_many "${RUN_DIR}" \
  scripts array_script "${BASH_SOURCE[0]}" \
  scripts runner_script "${RUNNER_SCRIPT}" \
  input_config config_path "${CONFIG_PATH}" \
  input_config parameter_table "${PARAMETER_TABLE}" \
  input_config fit_objects_dir "${FIT_OBJECTS_DIR}" \
  input_config flow_density_path "${FLOW_DENSITY_PATH}" \
  fit fitting_mode "joint" \
  fit run_prefix "${RUN_PREFIX}" \
  fit total_seeds "${TOTAL_SEEDS}" \
  fit array_tasks "${ARRAY_TASKS}" \
  fit seeds_per_task "${SEEDS_PER_TASK}" \
  optimizer n_cores "${N_CORES}" \
  optimizer itermax "${ITERMAX}" \
  optimizer NP "${NP}" \
  optimizer de_reltol "${DE_RELTOL}" \
  optimizer de_steptol "${DE_STEPTOL}" \
  joint joint_warmup_enable "${JOINT_WARMUP_ENABLE}" \
  joint joint_warmup_seed_label "${JOINT_WARMUP_SEED_LABEL}" \
  joint joint_warmup_invivo_seed_dir "${JOINT_WARMUP_INVIVO_SEED_DIR}" \
  joint joint_warmup_invitro_seed_dir "${JOINT_WARMUP_INVITRO_SEED_DIR}" \
  joint joint_soft_coupling_sigma_default "${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}" \
  joint joint_soft_coupling_welsch_c "${JOINT_SOFT_COUPLING_WELSCH_C}" \
  joint joint_soft_coupling_parameters_table "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}" \
  slurm array_job_id "${SLURM_ARRAY_JOB_ID:-NA}" \
  slurm array_task_id "${TASK_ID}" \
  slurm cpus "${SLURM_CPUS_PER_TASK:-${N_CORES}}"

MANIFEST_PATH="${RUN_DIR}/fit_array_manifest.tsv"
if [[ ! -f "${MANIFEST_PATH}" ]]; then
  {
    printf "key\tvalue\n"
    printf "project_root\t%s\n" "${PROJECT_ROOT}"
    printf "runner_script\t%s\n" "${RUNNER_SCRIPT}"
    printf "config_path\t%s\n" "${CONFIG_PATH}"
    printf "out_root\t%s\n" "${OUT_ROOT}"
    printf "run_prefix\t%s\n" "${RUN_PREFIX}"
    printf "total_seeds\t%s\n" "${TOTAL_SEEDS}"
    printf "array_tasks\t%s\n" "${ARRAY_TASKS}"
    printf "seeds_per_task\t%s\n" "${SEEDS_PER_TASK}"
    printf "n_cores\t%s\n" "${N_CORES}"
    printf "auto_viz\t%s\n" "${AUTO_VIZ}"
    printf "r_module\t%s\n" "${R_MODULE}"
    printf "itermax\t%s\n" "${ITERMAX}"
    printf "de_reltol\t%s\n" "${DE_RELTOL}"
    printf "de_steptol\t%s\n" "${DE_STEPTOL}"
    printf "NP\t%s\n" "${NP}"
    printf "joint_warmup_enable\t%s\n" "${JOINT_WARMUP_ENABLE}"
    printf "joint_warmup_seed_label\t%s\n" "${JOINT_WARMUP_SEED_LABEL}"
    printf "joint_warmup_invivo_seed_dir\t%s\n" "${JOINT_WARMUP_INVIVO_SEED_DIR}"
    printf "joint_warmup_invitro_seed_dir\t%s\n" "${JOINT_WARMUP_INVITRO_SEED_DIR}"
    printf "joint_warmup_sigmaN\t%s\n" "${JOINT_WARMUP_SIGMAN}"
    printf "joint_soft_coupling_sigma_default\t%s\n" "${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}"
    printf "joint_soft_coupling_welsch_c\t%s\n" "${JOINT_SOFT_COUPLING_WELSCH_C}"
    printf "joint_soft_coupling_parameters_table\t%s\n" "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}"
    printf "invitro_parameter_table\t%s\n" "${PARAMETER_TABLE}"
    printf "fit_objects_dir\t%s\n" "${FIT_OBJECTS_DIR}"
    printf "flow_density_path\t%s\n" "${FLOW_DENSITY_PATH}"
    printf "flow_density_enabled\t%s\n" "${FLOW_DENSITY_ENABLED}"
    printf "slurm_array_job_id\t%s\n" "${SLURM_ARRAY_JOB_ID:-NA}"
  } > "${MANIFEST_PATH}"
fi

echo "Starting joint fit array task"
echo "  slurm_array_job_id: ${SLURM_ARRAY_JOB_ID:-NA}"
echo "  task_id: ${TASK_ID}/${ARRAY_TASKS}"
echo "  seeds: ${SEED_START}-${SEED_END}"
echo "  seeds_csv: ${SEEDS_CSV}"
echo "  run_prefix: ${RUN_PREFIX}"
echo "  run_dir: ${RUN_DIR}"
echo "  n_cores: ${N_CORES}"
echo "  auto_viz: ${AUTO_VIZ}"
echo "  r_module: ${R_MODULE}"
echo "  itermax: ${ITERMAX}"
echo "  de_reltol: ${DE_RELTOL}"
echo "  de_steptol: ${DE_STEPTOL}"
echo "  NP: ${NP}"
echo "  joint_warmup_enable: ${JOINT_WARMUP_ENABLE}"
echo "  joint_warmup_seed_label: ${JOINT_WARMUP_SEED_LABEL}"
echo "  joint_warmup_invivo_seed_dir: ${JOINT_WARMUP_INVIVO_SEED_DIR}"
echo "  joint_warmup_invitro_seed_dir: ${JOINT_WARMUP_INVITRO_SEED_DIR}"
echo "  joint_soft_coupling_sigma_default: ${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}"
echo "  joint_soft_coupling_welsch_c: ${JOINT_SOFT_COUPLING_WELSCH_C}"
echo "  joint_soft_coupling_parameters_table: ${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}"
echo "  invitro_parameter_table: ${PARAMETER_TABLE}"
echo "  fit_objects_dir: ${FIT_OBJECTS_DIR}"
echo "  flow_density_path: ${FLOW_DENSITY_PATH}"
echo "  flow_density_enabled: ${FLOW_DENSITY_ENABLED}"

export O2SD_ARRAY_SCRIPT="${BASH_SOURCE[0]}"
export O2SD_SLURM_ARRAY_JOB_ID="${SLURM_ARRAY_JOB_ID:-NA}"
export O2SD_SLURM_ARRAY_TASK_ID="${TASK_ID}"
export O2SD_RUN_COMMAND="$(o2sd_prov_shell_join bash "${RUNNER_SCRIPT}" \
  --mode=run \
  "--config=${CONFIG_PATH}" \
  "--out_root=${OUT_ROOT}" \
  "--run_prefix=${RUN_PREFIX}" \
  --append_run_prefix_timestamp=FALSE \
  "--seeds_csv=${SEEDS_CSV}" \
  "--n_cores=${N_CORES}" \
  "--auto_viz=${AUTO_VIZ}" \
  "--itermax=${ITERMAX}" \
  "--de_reltol=${DE_RELTOL}" \
  "--de_steptol=${DE_STEPTOL}" \
  "--NP=${NP}" \
  "--invitro_parameter_table=${PARAMETER_TABLE}" \
  "--fit_objects_dir=${FIT_OBJECTS_DIR}" \
  "${JOINT_WARMUP_ARGS[@]}" \
  "${FLOW_DENSITY_ARGS[@]}")"

bash "${RUNNER_SCRIPT}" \
  --mode=run \
  --config="${CONFIG_PATH}" \
  --out_root="${OUT_ROOT}" \
  --run_prefix="${RUN_PREFIX}" \
  --append_run_prefix_timestamp=FALSE \
  --seeds_csv="${SEEDS_CSV}" \
  --n_cores="${N_CORES}" \
  --auto_viz="${AUTO_VIZ}" \
  --itermax="${ITERMAX}" \
  --de_reltol="${DE_RELTOL}" \
  --de_steptol="${DE_STEPTOL}" \
  --NP="${NP}" \
  --invitro_parameter_table="${PARAMETER_TABLE}" \
  --fit_objects_dir="${FIT_OBJECTS_DIR}" \
  "${JOINT_WARMUP_ARGS[@]}" \
  "${FLOW_DENSITY_ARGS[@]}"

echo "Task ${TASK_ID} completed."
