#!/bin/bash
# Run one row from a multi-warmup task table.
#
# This script is intended to be submitted as a Slurm array by
# submit_multi_warmup_task_table.sh. Each array task reads one row from
# multi_warmup_tasks.tsv and then calls the existing joint runner with the
# row-specific warm-up pair and joint seed.

#SBATCH --job-name=o2mw_task
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=22
#SBATCH --mem=32G
#SBATCH --qos=xxlarge
#SBATCH --time=12:00:00
#SBATCH --array=1-1
#SBATCH --output=/share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/results/log/o2mw_task_%A_%a.out
#SBATCH --error=/share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/results/log/o2mw_task_%A_%a.err

set -euo pipefail

O2SD_SHELL_UTILS="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../util" && pwd)/o2_supply_demand_map_shell_utils.sh"
# shellcheck source=../../util/o2_supply_demand_map_shell_utils.sh
source "${O2SD_SHELL_UTILS}"

require_file() {
  local label="$1"
  local path="$2"
  if [[ ! -f "${path}" ]]; then
    echo "Missing ${label}: ${path}" >&2
    exit 1
  fi
}

require_dir() {
  local label="$1"
  local path="$2"
  if [[ ! -d "${path}" ]]; then
    echo "Missing ${label}: ${path}" >&2
    exit 1
  fi
}

status_allowed() {
  local status="$1"
  local filter="$2"
  if [[ -z "${filter}" || "${filter}" == "all" || "${filter}" == "ALL" ]]; then
    return 0
  fi
  local item
  IFS=',' read -ra items <<< "${filter}"
  for item in "${items[@]}"; do
    item="$(echo "${item}" | xargs)"
    if [[ "${item}" == "${status}" ]]; then
      return 0
    fi
  done
  return 1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
DEFAULT_PROJECT_ROOT="$(cd "${WORKFLOW_ROOT}/../../.." && pwd)"

TASKS_TSV="${TASKS_TSV:-}"
TASK_LOOKUP_COLUMN="${TASK_LOOKUP_COLUMN:-recommended_sbatch_array_index}"
PROJECT_ROOT="${PROJECT_ROOT:-${DEFAULT_PROJECT_ROOT}}"
R_MODULE="${R_MODULE:-R/4.4}"
SKIP_EXISTING="${SKIP_EXISTING:-TRUE}"
TASK_STATUS_FILTER="${TASK_STATUS_FILTER:-all}"
DRY_RUN="${DRY_RUN:-FALSE}"

if [[ -z "${TASKS_TSV}" ]]; then
  echo "TASKS_TSV is required." >&2
  exit 2
fi

TASK_ID="${SLURM_ARRAY_TASK_ID:-1}"
if ! [[ "${TASK_ID}" =~ ^[0-9]+$ ]] || (( TASK_ID < 1 )); then
  echo "Invalid SLURM_ARRAY_TASK_ID: ${TASK_ID}" >&2
  exit 2
fi

PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd)"
TASKS_TSV="$(cd "$(dirname "${TASKS_TSV}")" && pwd)/$(basename "${TASKS_TSV}")"
require_file "task table" "${TASKS_TSV}"
PROVENANCE_HELPER="${PROJECT_ROOT}/oxygen/code/O2_supply_demand_MAP/util/o2_supply_demand_map_shell_utils.sh"
if [[ -f "${PROVENANCE_HELPER}" ]]; then
  # shellcheck source=/dev/null
  source "${PROVENANCE_HELPER}"
else
  echo "Missing provenance helper: ${PROVENANCE_HELPER}" >&2
  exit 1
fi

load_r_module
if ! command -v Rscript >/dev/null 2>&1; then
  echo "Rscript not found after loading ${R_MODULE}." >&2
  exit 1
fi

TASK_ENV_FILE="$(mktemp "${TMPDIR:-/tmp}/o2mw_task_env.XXXXXX")"
cleanup() {
  rm -f "${TASK_ENV_FILE}"
}
trap cleanup EXIT

Rscript --vanilla - "${TASKS_TSV}" "${TASK_ID}" "${TASK_LOOKUP_COLUMN}" <<'RSCRIPT' |
args <- commandArgs(trailingOnly = TRUE)
path <- args[[1]]
task_id <- suppressWarnings(as.integer(args[[2]]))
lookup_col <- args[[3]]

tab <- read.delim(path, sep = "\t", stringsAsFactors = FALSE, check.names = FALSE)
if (!nrow(tab)) stop("Task table has no data rows: ", path, call. = FALSE)
if (!is.finite(task_id) || task_id < 1L) stop("Invalid task id: ", args[[2]], call. = FALSE)

row_idx <- NA_integer_
if (lookup_col %in% names(tab)) {
  key <- suppressWarnings(as.integer(tab[[lookup_col]]))
  hit <- which(key == task_id)
  if (length(hit) == 1L) row_idx <- hit[[1]]
  if (length(hit) > 1L) stop("Task lookup column is not unique for task id ", task_id, call. = FALSE)
}
if (!is.finite(row_idx)) {
  if (task_id > nrow(tab)) stop("Task id ", task_id, " exceeds task table rows: ", nrow(tab), call. = FALSE)
  row_idx <- task_id
}
row <- tab[row_idx, , drop = FALSE]

value <- function(name, default = "") {
  if (!name %in% names(row)) return(default)
  x <- row[[name]][[1]]
  if (is.na(x)) return(default)
  as.character(x)
}
emit <- function(name, val) {
  cat(name, "=", shQuote(as.character(val), type = "sh"), "\n", sep = "")
}

emit("TASK_TABLE_ROW_INDEX", row_idx)
emit("GLOBAL_TASK_ID", value("global_task_id", task_id))
emit("TASK_STATUS", value("task_status", ""))
emit("TASK_KEY", value("task_key", ""))
emit("WARMUP_LABEL", value("warmup_label", ""))
emit("JOINT_SEED", value("joint_seed", ""))
emit("SEEDS_CSV", value("seeds_csv", value("joint_seed", "")))
emit("RUN_PREFIX", value("joint_run_prefix", ""))
emit("OUT_ROOT", value("out_root", ""))
emit("RUN_DIR", value("joint_run_dir", ""))
emit("OUTPUT_SEED_DIR", value("output_seed_dir", ""))
emit("FIT_SUMMARY_PATH", value("fit_summary_path", ""))
emit("BEST_PARAMS_PATH", value("best_params_path", ""))
emit("CONFIG_PATH", value("config_path", ""))
emit("RUNNER_SCRIPT", value("runner_script", ""))
emit("PARAMETER_TABLE", value("parameter_table", ""))
emit("FIT_OBJECTS_DIR", value("fit_objects_dir", ""))
emit("FLOW_DENSITY_PATH", value("flow_density_path", ""))
emit("FLOW_DENSITY_ENABLED", value("flow_density_enabled", "TRUE"))
emit("N_CORES", value("n_cores", Sys.getenv("SLURM_CPUS_PER_TASK", "22")))
emit("AUTO_VIZ", value("auto_viz", "TRUE"))
emit("ITERMAX", value("itermax", "1000"))
emit("DE_RELTOL", value("de_reltol", "1e-4"))
emit("DE_STEPTOL", value("de_steptol", "25"))
emit("NP", value("NP", "80"))
emit("JOINT_WARMUP_SEED_LABEL", value("joint_warmup_seed_label", value("warmup_label", "")))
emit("JOINT_WARMUP_INVIVO_SEED_DIR", value("joint_warmup_invivo_seed_dir", value("invivo_seed_dir", "")))
emit("JOINT_WARMUP_INVITRO_SEED_DIR", value("joint_warmup_invitro_seed_dir", value("invitro_seed_dir", "")))
emit("JOINT_WARMUP_SIGMAN", value("joint_warmup_sigmaN", ""))
emit("JOINT_SOFT_COUPLING_SIGMA_DEFAULT", value("joint_soft_coupling_sigma_default", ""))
emit("JOINT_SOFT_COUPLING_WELSCH_C", value("joint_soft_coupling_welsch_c", ""))
emit("JOINT_SOFT_COUPLING_PARAMETERS_TABLE", value("joint_soft_coupling_parameters_table", ""))
RSCRIPT
  awk '/^[A-Z][A-Z0-9_]*=/{print}' > "${TASK_ENV_FILE}"

if ! grep -q '^TASK_TABLE_ROW_INDEX=' "${TASK_ENV_FILE}"; then
  echo "R task-row parser did not emit a valid shell environment for task ${TASK_ID}." >&2
  exit 1
fi

# shellcheck disable=SC1090
. "${TASK_ENV_FILE}"

if ! status_allowed "${TASK_STATUS}" "${TASK_STATUS_FILTER}"; then
  echo "Skipping task because task_status=${TASK_STATUS} is not allowed by TASK_STATUS_FILTER=${TASK_STATUS_FILTER}."
  exit 0
fi

if [[ -z "${RUN_PREFIX}" || -z "${OUT_ROOT}" || -z "${SEEDS_CSV}" ]]; then
  echo "Task row is missing required run fields." >&2
  echo "  task_id: ${TASK_ID}" >&2
  echo "  warmup_label: ${WARMUP_LABEL:-}" >&2
  echo "  run_prefix: ${RUN_PREFIX:-}" >&2
  echo "  out_root: ${OUT_ROOT:-}" >&2
  echo "  seeds_csv: ${SEEDS_CSV:-}" >&2
  exit 1
fi

if [[ -z "${RUNNER_SCRIPT}" ]]; then
  RUNNER_SCRIPT="${PROJECT_ROOT}/oxygen/code/O2_supply_demand_MAP/runner/run_fit_joint_model_O2_supply_demand_MAP.sh"
fi
if [[ -z "${CONFIG_PATH}" ]]; then
  CONFIG_PATH="${PROJECT_ROOT}/oxygen/config/O2_supply_demand.yaml"
fi
if [[ -z "${PARAMETER_TABLE}" ]]; then
  PARAMETER_TABLE="${PROJECT_ROOT}/oxygen/data/O2_supply_demand/parameter_table_invitro_buffering.csv"
fi
if [[ -z "${FIT_OBJECTS_DIR}" ]]; then
  FIT_OBJECTS_DIR="${PROJECT_ROOT}/oxygen/ploidyOxygen/data/fit_objects"
fi
if [[ -z "${FLOW_DENSITY_PATH}" ]]; then
  FLOW_DENSITY_PATH="${PROJECT_ROOT}/oxygen/data/g0g1_ploidy_density_grid.csv"
fi
if [[ -z "${RUN_DIR}" ]]; then
  RUN_DIR="${OUT_ROOT}/${RUN_PREFIX}"
fi
if [[ -z "${OUTPUT_SEED_DIR}" ]]; then
  OUTPUT_SEED_DIR="${RUN_DIR}/seed${SEEDS_CSV}"
fi
if [[ -z "${FIT_SUMMARY_PATH}" ]]; then
  FIT_SUMMARY_PATH="${OUTPUT_SEED_DIR}/fit_summary.tsv"
fi
if [[ -z "${BEST_PARAMS_PATH}" ]]; then
  BEST_PARAMS_PATH="${OUTPUT_SEED_DIR}/best_params.tsv"
fi

require_file "runner script" "${RUNNER_SCRIPT}"
require_file "config" "${CONFIG_PATH}"
require_file "in vitro parameter table" "${PARAMETER_TABLE}"
require_dir "fit objects directory" "${FIT_OBJECTS_DIR}"
require_dir "joint warm-up in vivo seed directory" "${JOINT_WARMUP_INVIVO_SEED_DIR}"
require_dir "joint warm-up in vitro seed directory" "${JOINT_WARMUP_INVITRO_SEED_DIR}"
require_file "joint soft-coupling parameter table" "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}"

FLOW_DENSITY_ARGS=()
if truthy "${FLOW_DENSITY_ENABLED}" && [[ -f "${FLOW_DENSITY_PATH}" ]]; then
  FLOW_DENSITY_ARGS=("--flow_density_path=${FLOW_DENSITY_PATH}")
fi

if truthy "${SKIP_EXISTING}" && [[ -f "${FIT_SUMMARY_PATH}" && -f "${BEST_PARAMS_PATH}" ]]; then
  echo "Skipping complete task: ${TASK_KEY:-task ${TASK_ID}}"
  echo "  output_seed_dir: ${OUTPUT_SEED_DIR}"
  exit 0
fi

JOINT_WARMUP_ARGS=(
  "--joint_warmup_enable=TRUE"
  "--joint_warmup_seed_label=${JOINT_WARMUP_SEED_LABEL}"
  "--joint_warmup_invivo_seed_dir=${JOINT_WARMUP_INVIVO_SEED_DIR}"
  "--joint_warmup_invitro_seed_dir=${JOINT_WARMUP_INVITRO_SEED_DIR}"
  "--joint_soft_coupling_parameters_table=${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}"
)
if [[ -n "${JOINT_WARMUP_SIGMAN}" ]]; then
  JOINT_WARMUP_ARGS+=("--joint_warmup_sigmaN=${JOINT_WARMUP_SIGMAN}")
fi
if [[ -n "${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}" ]]; then
  JOINT_WARMUP_ARGS+=("--joint_soft_coupling_sigma_default=${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}")
fi
if [[ -n "${JOINT_SOFT_COUPLING_WELSCH_C}" ]]; then
  JOINT_WARMUP_ARGS+=("--joint_soft_coupling_welsch_c=${JOINT_SOFT_COUPLING_WELSCH_C}")
fi

mkdir -p "${RUN_DIR}"
MANIFEST_PATH="${RUN_DIR}/fit_array_manifest.tsv"
if [[ ! -f "${MANIFEST_PATH}" ]]; then
  tmp_manifest="${MANIFEST_PATH}.${SLURM_ARRAY_JOB_ID:-manual}.${TASK_ID}.tmp"
  {
    printf "key\tvalue\n"
    printf "project_root\t%s\n" "${PROJECT_ROOT}"
    printf "runner_script\t%s\n" "${RUNNER_SCRIPT}"
    printf "config_path\t%s\n" "${CONFIG_PATH}"
    printf "out_root\t%s\n" "${OUT_ROOT}"
    printf "run_prefix\t%s\n" "${RUN_PREFIX}"
    printf "task_table\t%s\n" "${TASKS_TSV}"
    printf "task_lookup_column\t%s\n" "${TASK_LOOKUP_COLUMN}"
    printf "global_task_array\tTRUE\n"
    printf "n_cores\t%s\n" "${N_CORES}"
    printf "auto_viz\t%s\n" "${AUTO_VIZ}"
    printf "r_module\t%s\n" "${R_MODULE}"
    printf "itermax\t%s\n" "${ITERMAX}"
    printf "de_reltol\t%s\n" "${DE_RELTOL}"
    printf "de_steptol\t%s\n" "${DE_STEPTOL}"
    printf "NP\t%s\n" "${NP}"
    printf "joint_warmup_enable\tTRUE\n"
    printf "joint_warmup_seed_label\t%s\n" "${JOINT_WARMUP_SEED_LABEL}"
    printf "joint_warmup_invivo_seed_dir\t%s\n" "${JOINT_WARMUP_INVIVO_SEED_DIR}"
    printf "joint_warmup_invitro_seed_dir\t%s\n" "${JOINT_WARMUP_INVITRO_SEED_DIR}"
    printf "joint_warmup_sigmaN\t%s\n" "${JOINT_WARMUP_SIGMAN}"
    printf "joint_soft_coupling_sigma_default\t%s\n" "${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}"
    printf "joint_soft_coupling_welsch_c\t%s\n" "${JOINT_SOFT_COUPLING_WELSCH_C}"
    printf "joint_soft_coupling_parameters_table\t%s\n" "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}"
    printf "invitro_parameter_table\t%s\n" "${PARAMETER_TABLE}"
    printf "fit_objects_dir\t%s\n" "${FIT_OBJECTS_DIR}"
    printf "flow_density_path\t%s\n" "${FLOW_DENSITY_PATH}"
    printf "flow_density_enabled\t%s\n" "${FLOW_DENSITY_ENABLED}"
    printf "slurm_array_job_id\t%s\n" "${SLURM_ARRAY_JOB_ID:-NA}"
  } > "${tmp_manifest}"
  mv -n "${tmp_manifest}" "${MANIFEST_PATH}" 2>/dev/null || rm -f "${tmp_manifest}"
fi

echo "Starting multi-warmup task-table joint fit"
echo "  slurm_array_job_id: ${SLURM_ARRAY_JOB_ID:-NA}"
echo "  task_id: ${TASK_ID}"
echo "  task_table_row_index: ${TASK_TABLE_ROW_INDEX}"
echo "  global_task_id: ${GLOBAL_TASK_ID}"
echo "  task_key: ${TASK_KEY}"
echo "  warmup_label: ${WARMUP_LABEL}"
echo "  joint_seed: ${JOINT_SEED}"
echo "  seeds_csv: ${SEEDS_CSV}"
echo "  run_prefix: ${RUN_PREFIX}"
echo "  run_dir: ${RUN_DIR}"
echo "  output_seed_dir: ${OUTPUT_SEED_DIR}"
echo "  joint_warmup_invivo_seed_dir: ${JOINT_WARMUP_INVIVO_SEED_DIR}"
echo "  joint_warmup_invitro_seed_dir: ${JOINT_WARMUP_INVITRO_SEED_DIR}"
echo "  joint_soft_coupling_parameters_table: ${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}"

cmd=(
  bash "${RUNNER_SCRIPT}"
  --mode=run
  "--config=${CONFIG_PATH}"
  "--out_root=${OUT_ROOT}"
  "--run_prefix=${RUN_PREFIX}"
  --append_run_prefix_timestamp=FALSE
  "--seeds_csv=${SEEDS_CSV}"
  "--n_cores=${N_CORES}"
  "--auto_viz=${AUTO_VIZ}"
  "--itermax=${ITERMAX}"
  "--de_reltol=${DE_RELTOL}"
  "--de_steptol=${DE_STEPTOL}"
  "--NP=${NP}"
  "--invitro_parameter_table=${PARAMETER_TABLE}"
  "--fit_objects_dir=${FIT_OBJECTS_DIR}"
  "${JOINT_WARMUP_ARGS[@]}"
  "${FLOW_DENSITY_ARGS[@]}"
)

o2sd_prov_write_standard "${RUN_DIR}" "${BASH_SOURCE[0]}" "${O2SD_RUN_COMMAND:-}"
o2sd_prov_write_many "${RUN_DIR}" \
  scripts array_script "${BASH_SOURCE[0]}" \
  scripts runner_script "${RUNNER_SCRIPT}" \
  input_config config_path "${CONFIG_PATH}" \
  input_config parameter_table "${PARAMETER_TABLE}" \
  input_config fit_objects_dir "${FIT_OBJECTS_DIR}" \
  input_config flow_density_path "${FLOW_DENSITY_PATH}" \
  fit fitting_mode "multi_warmup_joint" \
  fit run_prefix "${RUN_PREFIX}" \
  fit seed "${JOINT_SEED}" \
  multi_warmup task_table_path "${TASKS_TSV}" \
  multi_warmup task_key "${TASK_KEY}" \
  multi_warmup warmup_label "${WARMUP_LABEL}" \
  joint joint_warmup_seed_label "${JOINT_WARMUP_SEED_LABEL}" \
  joint joint_warmup_invivo_seed_dir "${JOINT_WARMUP_INVIVO_SEED_DIR}" \
  joint joint_warmup_invitro_seed_dir "${JOINT_WARMUP_INVITRO_SEED_DIR}" \
  joint joint_soft_coupling_sigma_default "${JOINT_SOFT_COUPLING_SIGMA_DEFAULT}" \
  joint joint_soft_coupling_welsch_c "${JOINT_SOFT_COUPLING_WELSCH_C}" \
  joint joint_soft_coupling_parameters_table "${JOINT_SOFT_COUPLING_PARAMETERS_TABLE}" \
  optimizer n_cores "${N_CORES}" \
  optimizer itermax "${ITERMAX}" \
  optimizer NP "${NP}" \
  optimizer de_reltol "${DE_RELTOL}" \
  optimizer de_steptol "${DE_STEPTOL}" \
  slurm array_job_id "${SLURM_ARRAY_JOB_ID:-NA}" \
  slurm array_task_id "${TASK_ID}" \
  slurm cpus "${SLURM_CPUS_PER_TASK:-${N_CORES}}"
export O2SD_ARRAY_SCRIPT="${BASH_SOURCE[0]}"
export O2SD_SLURM_ARRAY_JOB_ID="${SLURM_ARRAY_JOB_ID:-NA}"
export O2SD_SLURM_ARRAY_TASK_ID="${TASK_ID}"
export O2SD_RUN_COMMAND="$(o2sd_prov_shell_join "${cmd[@]}")"

printf "Command:"
printf " %q" "${cmd[@]}"
printf "\n"

if truthy "${DRY_RUN}"; then
  echo "DRY_RUN=TRUE; not running joint fit."
  exit 0
fi

cd "${PROJECT_ROOT}"
"${cmd[@]}"

echo "Task ${TASK_ID} completed."
