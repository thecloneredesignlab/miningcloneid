#!/bin/bash
# Run one fixed-O2 simulation task from task_list.tsv.
#
# Intended to be submitted as a Slurm array by submit_fix_o2_simulation_array.sh.
# Each array task reads one row and calls simulation/fix_o2_simulation.R with
# --worker_task=TRUE, so one Slurm job maps to one seed x O2 x ploidy x replicate.

#SBATCH --job-name=o2fix_sim
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --qos=small
#SBATCH --time=4:00:00
#SBATCH --array=1-1
#SBATCH --output=/share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/results/log/o2fix_sim_%A_%a.out
#SBATCH --error=/share/lab_crd/lab_crd/taoli/Project/miningcloneid/oxygen/results/log/o2fix_sim_%A_%a.err

set -euo pipefail

truthy() {
  case "${1:-FALSE}" in
    TRUE|true|True|1|yes|YES|y|Y|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

load_r_module() {
  if command -v ml >/dev/null 2>&1; then
    ml "${R_MODULE}"
  elif command -v module >/dev/null 2>&1; then
    module load "${R_MODULE}"
  fi
}

clean_cell() {
  local val="${1-}"
  val="${val//$'\t'/ }"
  val="${val//$'\r'/ }"
  val="${val//$'\n'/ }"
  printf "%s" "${val}"
}

write_status() {
  local status="$1"
  local exit_code="$2"
  local message="${3-}"
  local path="${STATUS_FILE}"
  local tmp="${path}.${SLURM_ARRAY_JOB_ID:-manual}.${TASK_ID}.tmp"
  mkdir -p "$(dirname "${path}")"
  {
    printf "task_id\tseed_id\tfixed_o2_pct\tinitial_ploidy\tsimulation_id\tstatus\texit_code\toutput_dir\tmessage\n"
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
      "$(clean_cell "${TASK_ID}")" \
      "$(clean_cell "${SEED_ID:-}")" \
      "$(clean_cell "${FIXED_O2_PCT:-}")" \
      "$(clean_cell "${INITIAL_PLOIDY:-}")" \
      "$(clean_cell "${SIMULATION_ID:-}")" \
      "$(clean_cell "${status}")" \
      "$(clean_cell "${exit_code}")" \
      "$(clean_cell "${OUTPUT_DIR:-}")" \
      "$(clean_cell "${message}")"
  } > "${tmp}"
  mv "${tmp}" "${path}"
}

require_file() {
  local label="$1"
  local path="$2"
  if [[ ! -f "${path}" ]]; then
    echo "Missing ${label}: ${path}" >&2
    exit 1
  fi
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
DEFAULT_PROJECT_ROOT="$(cd "${WORKFLOW_ROOT}/../../.." && pwd)"

PROJECT_ROOT="${PROJECT_ROOT:-${DEFAULT_PROJECT_ROOT}}"
TASKS_TSV="${TASKS_TSV:-}"
TASK_ENV_FILE="${TASK_ENV_FILE:-}"
TASK_LOOKUP_COLUMN="${TASK_LOOKUP_COLUMN:-task_id}"
R_MODULE="${R_MODULE:-R/4.4}"
SKIP_EXISTING="${SKIP_EXISTING:-FALSE}"
STATUS_DIR="${STATUS_DIR:-}"
DRY_RUN="${DRY_RUN:-FALSE}"

if [[ -z "${TASKS_TSV}" ]]; then
  echo "TASKS_TSV is required." >&2
  exit 2
fi
if [[ -z "${TASK_ENV_FILE}" ]]; then
  echo "TASK_ENV_FILE is required." >&2
  exit 2
fi

PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd)"
TASKS_TSV="$(cd "$(dirname "${TASKS_TSV}")" && pwd)/$(basename "${TASKS_TSV}")"
TASK_ENV_FILE="$(cd "$(dirname "${TASK_ENV_FILE}")" && pwd)/$(basename "${TASK_ENV_FILE}")"
require_file "task table" "${TASKS_TSV}"
require_file "task environment file" "${TASK_ENV_FILE}"

# shellcheck source=/dev/null
source "${TASK_ENV_FILE}"

SIM_SCRIPT="${SIM_SCRIPT:-${PROJECT_ROOT}/oxygen/code/O2_supply_demand_MAP/simulation/fix_o2_simulation.R}"
SIMULATION="${SIMULATION:-}"
TIME_DAYS="${TIME_DAYS:-}"
STATUS_DIR="${STATUS_DIR:-${OUT_ROOT}/${SIMULATION}/hpc_task_status}"

if [[ -z "${SIMULATION}" || -z "${TIME_DAYS}" ]]; then
  echo "TASK_ENV_FILE must define SIMULATION and TIME_DAYS." >&2
  exit 2
fi
require_file "fixed-O2 simulation script" "${SIM_SCRIPT}"

TASK_ID="${SLURM_ARRAY_TASK_ID:-1}"
if ! [[ "${TASK_ID}" =~ ^[0-9]+$ ]] || (( TASK_ID < 1 )); then
  echo "Invalid SLURM_ARRAY_TASK_ID: ${TASK_ID}" >&2
  exit 2
fi

load_r_module
if ! command -v Rscript >/dev/null 2>&1; then
  echo "Rscript not found after loading ${R_MODULE}." >&2
  exit 1
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

TASK_ROW_ENV="$(mktemp "${TMPDIR:-/tmp}/o2fix_task_env.XXXXXX")"
cleanup() {
  rm -f "${TASK_ROW_ENV}"
}
trap cleanup EXIT

Rscript --vanilla - "${TASKS_TSV}" "${TASK_ID}" "${TASK_LOOKUP_COLUMN}" > "${TASK_ROW_ENV}" <<'RSCRIPT'
args <- commandArgs(trailingOnly = TRUE)
path <- args[[1]]
task_id <- suppressWarnings(as.integer(args[[2]]))
lookup_col <- args[[3]]

tab <- read.delim(path, sep = "\t", stringsAsFactors = FALSE, check.names = FALSE)
if (!nrow(tab)) stop("Task table has no data rows: ", path, call. = FALSE)
if (!is.finite(task_id) || task_id < 1L) stop("Invalid task id: ", args[[2]], call. = FALSE)

row_idx <- NA_integer_
if (lookup_col %in% names(tab)) {
  key <- suppressWarnings(as.integer(tab[[lookup_col]]))
  hit <- which(key == task_id)
  if (length(hit) == 1L) row_idx <- hit[[1]]
  if (length(hit) > 1L) stop("Task lookup column is not unique for task id ", task_id, call. = FALSE)
}
if (!is.finite(row_idx)) {
  if (task_id > nrow(tab)) stop("Task id ", task_id, " exceeds task table rows: ", nrow(tab), call. = FALSE)
  row_idx <- task_id
}
row <- tab[row_idx, , drop = FALSE]

required <- c("task_id", "seed_id", "seed_dir", "fixed_o2_pct", "initial_ploidy", "simulation_id", "output_dir")
missing <- setdiff(required, names(row))
if (length(missing)) stop("Task row is missing column(s): ", paste(missing, collapse = ","), call. = FALSE)

value <- function(name, default = "") {
  x <- row[[name]][[1]]
  if (is.na(x)) return(default)
  as.character(x)
}
emit <- function(name, val) {
  cat(name, "=", shQuote(as.character(val), type = "sh"), "\n", sep = "")
}

emit("TASK_TABLE_ROW_INDEX", row_idx)
emit("TASK_TABLE_TASK_ID", value("task_id", task_id))
emit("SEED_ID", value("seed_id"))
emit("SEED_DIR", value("seed_dir"))
emit("FIXED_O2_PCT", value("fixed_o2_pct"))
emit("INITIAL_PLOIDY", value("initial_ploidy"))
emit("SIMULATION_ID", value("simulation_id"))
emit("OUTPUT_DIR", value("output_dir"))
RSCRIPT

# shellcheck disable=SC1090
source "${TASK_ROW_ENV}"

STATUS_DIR="$(mkdir -p "${STATUS_DIR}" && cd "${STATUS_DIR}" && pwd)"
STATUS_FILE="${STATUS_DIR}/task_${TASK_ID}.tsv"
mkdir -p "${OUTPUT_DIR}"

if truthy "${SKIP_EXISTING}"; then
  complete=TRUE
  for required in run_config.tsv parameters_used.tsv population_trajectory.tsv rate_trajectory.tsv.gz state_trajectory.tsv.gz; do
    if [[ ! -f "${OUTPUT_DIR}/${required}" ]]; then
      complete=FALSE
      break
    fi
  done
  if truthy "${complete}"; then
    echo "Skipping existing fixed-O2 simulation task ${TASK_ID}: ${OUTPUT_DIR}"
    write_status "skipped_existing" 0 "required outputs already exist"
    exit 0
  fi
fi

cmd=(
  Rscript "${SIM_SCRIPT}"
  "--worker_task=TRUE"
  "--fit_dir=${SEED_DIR}"
  "--simulation=${SIMULATION}"
  "--initial_ploidy=${INITIAL_PLOIDY}"
  "--time_days=${TIME_DAYS}"
  "--n_sim=1"
  "--simulation_id=${SIMULATION_ID}"
  "--o2=${FIXED_O2_PCT}"
  "--seed_id=${SEED_ID}"
  "--out_dir=${OUTPUT_DIR}"
)

if [[ -n "${DT:-}" ]]; then cmd+=("--dt=${DT}"); fi
if [[ -n "${SAVE_EVERY_DAYS:-}" ]]; then cmd+=("--save_every_days=${SAVE_EVERY_DAYS}"); fi
if [[ -n "${REPORT_DT:-}" ]]; then cmd+=("--report_dt=${REPORT_DT}"); fi
if [[ -n "${INITIAL_CELLS:-}" ]]; then cmd+=("--initial_cells=${INITIAL_CELLS}"); fi
if [[ -n "${JOINT_SCOPE:-}" ]]; then cmd+=("--joint_scope=${JOINT_SCOPE}"); fi
if [[ -n "${CROWDING:-}" ]]; then cmd+=("--Crowding=${CROWDING}"); fi
if [[ -n "${O2_GROWTH:-}" ]]; then cmd+=("--O2_growth=${O2_GROWTH}"); fi
if [[ -n "${START_WITH:-}" ]]; then cmd+=("--start_with=${START_WITH}"); fi
if [[ -n "${PLOIDY_O2_DEATH:-}" ]]; then cmd+=("--ploidy_O2_death=${PLOIDY_O2_DEATH}"); fi

{
  printf "Command:"
  printf " %q" "${cmd[@]}"
  printf "\n"
} | tee "${OUTPUT_DIR}/hpc_task_command.txt"

echo "Starting fixed-O2 simulation array task"
echo "  slurm_array_job_id: ${SLURM_ARRAY_JOB_ID:-NA}"
echo "  slurm_array_task_id: ${TASK_ID}"
echo "  task_table_row_index: ${TASK_TABLE_ROW_INDEX}"
echo "  seed_id: ${SEED_ID}"
echo "  fixed_o2_pct: ${FIXED_O2_PCT}"
echo "  initial_ploidy: ${INITIAL_PLOIDY}"
echo "  simulation_id: ${SIMULATION_ID}"
echo "  output_dir: ${OUTPUT_DIR}"

if truthy "${DRY_RUN}"; then
  write_status "dry_run" 0 "DRY_RUN=TRUE"
  echo "DRY_RUN=TRUE; not running simulation."
  exit 0
fi

set +e
"${cmd[@]}"
exit_code=$?
set -e

if (( exit_code == 0 )); then
  write_status "completed" 0 "ok"
  echo "Task ${TASK_ID} completed."
else
  write_status "failed" "${exit_code}" "Rscript exited nonzero"
  echo "Task ${TASK_ID} failed with exit_code=${exit_code}." >&2
fi
exit "${exit_code}"
