#!/bin/bash
# Slurm worker for fixed-O2 analytical-vs-simulation scatter plots.
#
# Submit through submit_fixo2_noemi_scatters.sh so CSV arguments are passed
# through an env file instead of Slurm's comma-delimited --export list.

#SBATCH --job-name=fixo2_scat
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --qos=xxlarge
#SBATCH --time=04:00:00
#SBATCH --output=fixo2_scat_%j.out
#SBATCH --error=fixo2_scat_%j.err

set -euo pipefail

if [[ -n "${ARG_ENV_FILE:-}" ]]; then
  # shellcheck disable=SC1090
  source "${ARG_ENV_FILE}"
fi

PROJECT_ROOT="${PROJECT_ROOT:?PROJECT_ROOT is required}"
PLOT_SCRIPT="${PLOT_SCRIPT:-${PROJECT_ROOT}/oxygen/code/O2_supply_demand_MAP/analysis/plot_fixo2_noemi_scatters.R}"
R_MODULE="${R_MODULE:-R/4.4}"

load_r_module() {
  if [[ -f /etc/profile.d/modules.sh ]]; then
    # shellcheck disable=SC1091
    source /etc/profile.d/modules.sh
  fi
  if command -v module >/dev/null 2>&1; then
    module use /app/eb/modules/all >/dev/null 2>&1 || true
  fi
  if command -v ml >/dev/null 2>&1; then
    ml "${R_MODULE}"
  elif command -v module >/dev/null 2>&1; then
    module load "${R_MODULE}"
  fi
}

load_r_module

if ! command -v Rscript >/dev/null 2>&1; then
  echo "Rscript not found after loading ${R_MODULE}." >&2
  exit 1
fi

cd "${PROJECT_ROOT}"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

args=(
  "--repo_root=${PROJECT_ROOT}"
  "--simulation_dir=${SIMULATION_DIR:-~/oxygen/results/O2_fixed_simulation}"
  "--analysis_dir=${ANALYSIS_DIR:-~/oxygen/results/analysis/FixO2_invivo_500seed}"
  "--fit_dir=${FIT_DIR:-~/oxygen/results/fit_invivo_O2_buffering_500seed}"
  "--run_dir=${RUN_DIR:-${FIT_DIR:-~/oxygen/results/fit_invivo_O2_buffering_500seed}}"
  "--out_dir=${OUT_DIR:-~/oxygen/results/analysis/FixO2_invivo_500seed}"
  "--simulation_mode=${SIMULATION_MODE:-invivo}"
  "--simulation_ids=${SIMULATION_IDS:-1,2,3}"
  "--seed_ids=${SEED_IDS:-}"
  "--time_points=${TIME_POINTS:-25,50,100,200,300,500,700,1000}"
  "--o2_values=${O2_VALUES:-0,0.1,0.5,1,2,5}"
  "--initial_ploidy_values=${INITIAL_PLOIDY_VALUES:-2,4}"
  "--progress_every=${PROGRESS_EVERY:-200}"
  "--objective_transform=${OBJECTIVE_TRANSFORM:-identity}"
  "--recompute=${RECOMPUTE:-FALSE}"
  "--cache_all_times=${CACHE_ALL_TIMES:-TRUE}"
  "--n_workers=${N_WORKERS:-${SLURM_CPUS_PER_TASK:-1}}"
  "--analytical_methods=${ANALYTICAL_METHODS:-eigen,expm}"
  "--recompute_analytical=${RECOMPUTE_ANALYTICAL:-FALSE}"
)

if [[ -n "${SIMULATION_METRIC_TABLE:-}" ]]; then
  args+=("--simulation_metric_table=${SIMULATION_METRIC_TABLE}")
fi
if [[ -n "${SIMULATION_SUMMARY_TABLE:-}" ]]; then
  args+=("--simulation_summary_table=${SIMULATION_SUMMARY_TABLE}")
fi
if [[ -n "${SCATTER_DATA_TABLE:-}" ]]; then
  args+=("--scatter_data_table=${SCATTER_DATA_TABLE}")
fi
if [[ -n "${ALL_TIME_SIMULATION_METRIC_TABLE:-}" ]]; then
  args+=("--all_time_simulation_metric_table=${ALL_TIME_SIMULATION_METRIC_TABLE}")
fi
if [[ -n "${ANALYTICAL_CACHE_TABLE:-}" ]]; then
  args+=("--analytical_cache_table=${ANALYTICAL_CACHE_TABLE}")
fi

echo "Running fixed-O2 Noemi scatter plotting"
echo "  host: $(hostname)"
echo "  project_root: ${PROJECT_ROOT}"
echo "  plot_script: ${PLOT_SCRIPT}"
echo "  arg_env_file: ${ARG_ENV_FILE:-}"
echo "  slurm_job_id: ${SLURM_JOB_ID:-}"
echo "  slurm_cpus_per_task: ${SLURM_CPUS_PER_TASK:-1}"
echo "  n_workers: ${N_WORKERS:-${SLURM_CPUS_PER_TASK:-1}}"
echo "  cache_all_times: ${CACHE_ALL_TIMES:-TRUE}"
echo "  analytical_methods: ${ANALYTICAL_METHODS:-eigen,expm}"
echo "  run_dir: ${RUN_DIR:-${FIT_DIR:-~/oxygen/results/fit_invivo_O2_buffering_500seed}}"

Rscript "${PLOT_SCRIPT}" "${args[@]}"
