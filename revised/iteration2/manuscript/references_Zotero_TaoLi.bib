	date = {2000-09},
	keywords = {Acoustic noise, Focusing, Geologic measurements, Laplace equations, Microscopy, Noise robustness, Performance analysis, Performance evaluation, Pixel, Size measurement},
	file = {IEEE Xplore Abstract Record:/Users/4482173/Zotero/storage/RA7HRHNQ/903548.html:text/html},
}

