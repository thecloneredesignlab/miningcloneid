	doi = {10.1038/nm.3716},
	abstract = {Pediatric brainstem gliomas often harbor oncogenic K27M mutation of histone H3.3. Here we show that {GSKJ}4 pharmacologic inhibition of K27 demethylase {JMJD}3 increases cellular H3K27 methylation in K27M tumor cells and demonstrate potent antitumor activity both in vitro against K27M cells and in vivo against K27M xenografts. Our results demonstrate that increasing H3K27 methylation by inhibiting K27 demethylase is a valid therapeutic strategy for treating K27M-expressing brainstem glioma.},
