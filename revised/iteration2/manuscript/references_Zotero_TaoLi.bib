	issn = {1052-2166},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4758516/},
	doi = {10.3727/105221615X14399878166113},
	shorttitle = {{GATA}3 in Breast Cancer},
	abstract = {{GATA}3 is a highly conserved, essential transcription factor expressed in a number of tissues, including the mammary gland. {GATA}3 expression is required for normal development of the mammary gland where it is estimated to be the most abundant transcription factor in luminal epithelial cells. In breast cancer, {GATA}3 expression is highly correlated with the luminal transcriptional program. Recent genomic analysis of human breast cancers has revealed high-frequency mutation in {GATA}3 in luminal tumors, suggesting “driver” function(s). Here we discuss mutation of {GATA}3 in breast cancer and the potential mechanism(s) by which mutation may lead to a growth advantage in cancer.},
