	note = {Read\_Status: New
Read\_Status\_Date: 2025-11-22T17:35:06.355Z},
	keywords = {{ROS}, {ATP} synthesis, chromatin remodeling, microenvironment acidification, Warburg Effect},
}

@article{keenan_alternative_2015,
	title = {Alternative Fuels for Cancer Cells},
	volume = {21},
	issn = {1540-336X},
	url = {https://journals.lww.com/journalppo/fulltext/2015/03000/alternative_fuels_for_cancer_cells.2.aspx},
	abstract = {Tumor metabolism is significantly altered to support the various metabolic needs of tumor cells. The most prominent change is the increased tumor glycolysis that leads to increased glucose uptake and utilization. However, it has become obvious that many nonglucose nutrients, such as amino acids, lactate, acetate, and macromolecules, can serve as alternative fuels for cancer cells. This knowledge reveals an unexpected flexibility and evolutionarily conserved model in which cancer cells uptake nutrients from their external environment to fulfill their necessary energetic needs. Tumor cells may have evolved the ability to utilize different carbon sources because of the limited supply of nutrients in their microenvironment, which can be driven by oncogenic mutations or tumor microenvironmental stresses. In certain cases, these factors permanently alter the tumor cells’ metabolism, causing certain nutrients to become indispensable and thus creating opportunities for therapeutic intervention to eradicate tumors by their metabolic vulnerabilities.},
	number = {2},
	journaltitle = {The Cancer Journal},
	author = {Keenan, Melissa M. and Chi, Jen-Tsan},
	date = {2015},
	note = {Read\_Status: New
Read\_Status\_Date: 2025-11-22T17:35:06.355Z},
	keywords = {amino acids, Tumor metabolism, acetate, alternative fuels, lactate, macromolecules, nonglucose nutrients, oncogenic mutations, tumor cells, tumor glycolysis, tumor microenvironmental stresses},
