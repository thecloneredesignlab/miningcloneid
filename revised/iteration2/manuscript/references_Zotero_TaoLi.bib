@article{bogart_family_2019,
	title = {A family study to examine clonal diversity in unisexual salamanders (genus Ambystoma)},
	volume = {62},
	issn = {0831-2796},
	url = {https://cdnsciencepub.com/doi/abs/10.1139/gen-2019-0034},
	doi = {10.1139/gen-2019-0034},
	abstract = {Unisexual Ambystoma are the oldest known unisexual vertebrates and comprise a lineage of eastern North American all female salamanders that reproduce by stealing sperm from as many as five normally bisexual congeneric species. The sperm may be used to only stimulate egg development by gynogenesis but can be incorporated in the zygote to elevate the ploidy level or to replace one of the female’s haploid genomes. This flexible and unique reproductive system, termed kleptogenesis, is investigated using a microsatellite examination of 988 offspring from 14 unisexual mothers. All mothers produced clonal and ploidy-elevated offspring. Genome replacement and multiple paternity are confirmed for the first time in unisexual Ambystoma. Microsatellite mutations were found in all five microsatellite loci and the estimated microsatellite mutation rate varied by locus and by genome. Clonal variation is attributed to the inclusion of sperm donors’ haploid genomes for ploidy elevation, genome replacement, mutations, and natural selection.},
	pages = {549--561},
	number = {8},
	journaltitle = {Genome},
	publisher = {{NRC} Research Press},
	author = {Bogart, James P.},
	urldate = {2025-04-28},
	date = {2019-08},
}

