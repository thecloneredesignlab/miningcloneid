	date = {2005-03-10},
	keywords = {Glioblastoma, Humans, Brain Neoplasms, Survival Analysis, Antineoplastic Agents, Alkylating, Chemotherapy, Adjuvant, Dacarbazine, Disease-Free Survival, {DNA} Methylation, Gene Silencing, O(6)-Methylguanine-{DNA} Methyltransferase, Polymerase Chain Reaction, Promoter Regions, Genetic, Randomized Controlled Trials as Topic, Temozolomide},
