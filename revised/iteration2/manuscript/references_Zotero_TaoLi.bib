@article{katzenstein_prognostic_1998,
	title = {Prognostic significance of age, {MYCN} oncogene amplification, tumor cell ploidy, and histology in 110 infants with stage D(S) neuroblastoma: the pediatric oncology group experience--a pediatric oncology group study.},
	volume = {16},
