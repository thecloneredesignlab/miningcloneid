	url = {https://www.frontiersin.orghttps://www.frontiersin.org/journals/pharmacology/articles/10.3389/fphar.2017.00119/full},
	doi = {10.3389/fphar.2017.00119},
	shorttitle = {Aldo–Keto Reductase {AKR}1C1–{AKR}1C4},
	abstract = {Aldo–keto reductases comprise of {AKR}1C1–{AKR}1C4, four enzymes that catalyze {NADPH} dependent reductions and have been implicated in biosynthesis, intermediary metabolism, and detoxification. Recent studies have provided evidences of strong correlation between the expression levels of these family members and the malignant transformation as well as the resistance to cancer therapy. Mechanistically, most studies focus on the catalytic-dependent function of {AKR}1C isoforms, like their impeccable roles in prostate cancer, breast cancer, and drug resistance due to the broad substrates specificity. However, accumulating clues showed that catalytic-independent functions also played critical roles in regulating biological events. This review summarizes the catalytic-dependent and -independent roles of {AKR}1Cs, as well as the small molecule inhibitors targeting these family members.},
