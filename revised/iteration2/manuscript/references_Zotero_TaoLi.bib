@incollection{corral-frias_imaging_2016,
	title = {Imaging Genetics of the Hypothalamic- Pituitary-Adrenal Axis: Implications for Psychopathology},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0023},
	doi = {10.1093/med/9780199920211.003.0023},
	shorttitle = {Imaging Genetics of the Hypothalamic- Pituitary-Adrenal Axis},
	abstract = {The experience of stress triggers a biological-behavioral cascade governed by the corticolimbic network. Within the neuroendocrine system, the hypothalamic-pituitary-adrenal ({HPA}) axis is a central coordinator that both readies the body to respond to environmental challenge and facilitates the return to homeostasis. Emerging research suggests that abnormal {HPA} axis function and genetic variation within the {HPA} axis play a causal role in the development of psychiatric illness. This chapter reviews current literature describing associations between {HPA} axis polymorphisms and amygdala structure, function, and connectivity. Despite the indisputable potential of {HPA} axis imaging genetics research to contribute to etiologic understanding of stress-related psychiatric disease, the field has been met with many challenges. The chapter highlights these challenges and suggests future methodological developments that will allow for the advancement of the stress-related imaging genetics and, ultimately, expand the mechanistic understanding of how variability in {HPA} axis function may promote the development of psychopathology.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Corral-Frías, Nadia S. and Michalski, Lindsay J. and Di Iorio, Christina R. and Bogdan, Ryan},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{muse_neurobiology_2016,
	title = {Neurobiology and Genetics of Cognitive Aging: Insights from Neuroimaging Studies},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0021},
	doi = {10.1093/med/9780199920211.003.0021},
	shorttitle = {Neurobiology and Genetics of Cognitive Aging},
	abstract = {This chapter, Neurobiology and Genetics of Cognitive Aging: Insights from Neuroimaging Studies, reviews the cognitive changes that occur with aging, the current understanding of the neurobiology underlying these changes, the role of genes in the individual variability in trajectories of age-related changes in cognition, and the utility of imaging genetics of cognitive aging. Understanding mechanisms including genetic factors that confer resilience or susceptibility to age-associated cognitive changes and neurodegenerative disorders will prove useful in discovering novel strategies to tackle these disorders in the elderly. This chapter will be of interest to scientists and physicians involved in translational neuroscience research in the elderly.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Muse, John C. and Nowrangi, Milap A. and Weinberger, Daniel R. and Mattay, Venkata S.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{lett_imaging_2016,
	title = {Imaging Genetics of Working Memory},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0020},
	doi = {10.1093/med/9780199920211.003.0020},
	abstract = {This chapter presents an overview of the most important findings on imaging genetics of working memory. Working memory refers to the temporary storage and manipulation of information to guide goal-directed behavior in the absence of the original input Dysfunction of this integral cognitive process is prominent in many psychiatric disorders. The chapter discusses the following: (1) the theoretical and neurobiological mechanisms underlying working memory, (2) the impact of genetic variation on neuroimaging phenotypes relevant to working memory, and (3) the clinical relevance, limitations, and future directions in the field of imaging genetics of working memory. Imaging genetics provides important insights into the genetics, anatomy, and pathophysiology of working memory dysfunction that may ultimately lead to better treatment options.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
