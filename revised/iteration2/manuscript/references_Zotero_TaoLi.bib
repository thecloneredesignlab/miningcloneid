	note = {Read\_Status: New
Read\_Status\_Date: 2026-01-27T20:29:20.504Z},
	keywords = {Humans, Prognosis, Colorectal Neoplasms, Neoplasms, Phenotype, Cell Line, Tumor, Cell Line, Tumor, polyploidy, {DNA} Copy Number Variations, Ploidies, Chromosomal Instability},
