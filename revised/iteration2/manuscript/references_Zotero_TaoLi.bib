@article{klapars_efficient_2021,
	title = {Efficient synthesis of antiviral agent uprifosbuvir enabled by new synthetic methods},
	volume = {12},
	issn = {2041-6520},
	url = {http://dx.doi.org/10.1039/D1SC01978C},
