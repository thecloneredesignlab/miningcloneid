@article{alessi_multi-institutional_2023,
	title = {Multi-institutional analysis of aneuploidy and outcomes to chemoradiation and durvalumab in stage {III} non-small cell lung cancer},
	volume = {11},
	url = {https://doi.org/10.1136/jitc-2023-007618},
	doi = {10.1136/jitc-2023-007618},
	abstract = {There is a need to identify predictive biomarkers to guide treatment strategies in stage {III} non-small cell lung cancer ({NSCLCs}). In this multi-institutional cohort of 197 patients with stage {III} {NSCLC} treated with concurrent chemoradiation ({cCRT}) and durvalumab consolidation, we identify that low tumor aneuploidy is independently associated with prolonged progression-free survival ({HR} 0.63; p=0.03) and overall survival ({HR} 0.50; p=0.03). Tumors with high aneuploidy had a significantly greater incidence of distant metastasis and shorter median distant-metastasis free survival (p=0.04 and p=0.048, respectively), but aneuploidy level did not associate with local-regional outcomes. Multiplexed immunofluorescence analysis in a cohort of {NSCLC} found increased intratumoral {CD}8-positive, {PD}-1-positive cells, double-positive {PD}-1 {CD}8 cells, and {FOXP}3-positive T-cell in low aneuploid tumors. Additionally, in a cohort of 101 patients treated with {cCRT} alone, tumor aneuploidy did not associate with disease outcomes. These data support the need for upfront treatment intensification strategies in stage {III} {NSCLC} patients with high aneuploid tumors and suggest that tumor aneuploidy is a promising predictive biomarker.},
	pages = {e007618},
	number = {11},
	journaltitle = {Journal for {ImmunoTherapy} of Cancer},
	shortjournal = {Journal for {ImmunoTherapy} of Cancer},
	author = {Alessi, Joao V and Price, Adam and Richards, Allison L and Ricciuti, Biagio and Wang, Xinan and Elkrief, Arielle and Pecci, Federica and Di Federico, Alessandro and Gandhi, Malini M and Lebow, Emily S and Santos, Patricia Mae G and Thor, Maria and Rimner, Andreas and Schoenfeld, Adam J and Chaft, Jamie E and Johnson, Bruce E and Gomez, Daniel R and Awad, Mark M and Shaverdian, Narek},
	date = {2023-11-01},
