@incollection{rasch_imaging_2016,
	title = {Imaging Genetics of Episodic Memory},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0019},
	doi = {10.1093/med/9780199920211.003.0019},
	abstract = {Human cognitive functions are highly variable across individuals and are both genetically and environmentally influenced. Recent behavioral genetics studies have identified several common genetic polymorphisms, which are related to individual differences in memory performance. In addition, imaging genetics studies are starting to explore the neural correlates of genetic differences in memory functions on the level of brain circuits. This chapter describes how functional magnetic resonance imaging ({fMRI}) can be used to validate and extend findings of behavioral genetics studies of episodic memory and gives examples of recent advances in this field. It presents advantages and problems related to the different sensitivity of behavioral versus imaging genetics studies and discusses possible methodological approaches for an appropriate evaluation and integration of the results. Although the field of imaging genetics of episodic memory is still young, it can potentially enhance understanding of the neural mechanisms that underlie genetic differences in memory.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Rasch, Björn and Erk, Susanne and Papassotiropoulos, Andreas and de Quervain, Dominique J.-F.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{harrison_neuroimaging_2016,
	title = {Neuroimaging Genetics of Alzheimer’s Disease},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0022},
	doi = {10.1093/med/9780199920211.003.0022},
	abstract = {Alzheimer’s disease ({AD}) is the most common cause of dementia. Over 5 million Americans are currently suffering from the disease. The majority of {AD} cases are sporadic, meaning there is no single, identifiable genetic cause. There are also autosomal dominant forms of {AD}, or familial {AD}, as well as a highly penetrant association between Down syndrome and {AD}. This chapter provides an introduction to the clinical and pathological features of {AD}, followed by a review of the neuroimaging findings related to familial {AD}, Down syndrome, and risk genes for sporadic, late-onset {AD}. It discusses new approaches to neuroimaging genetics in {AD}, including using imaging endophenotypes to identify potential risk genes. The chapter concludes by speculating on how neuroimaging genetics of {AD} can be used to improve clinical trial design and, therefore, affect the ability to develop effective treatment strategies for {AD}.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Harrison, Theresa M. and Burggren, Alison C. and Bookheimer, Susan Y.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{hyde_incorporating_2016,
	title = {Incorporating the Environment into Neurogenetics Research: An Imaging-Gene-by-Environment Interactions ({IG} x E) Approach},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0018},
	doi = {10.1093/med/9780199920211.003.0018},
	shorttitle = {Incorporating the Environment into Neurogenetics Research},
	abstract = {Examining the interplay of genes, environmental experience, and the brain is critical to understanding complex behavior, personality and psychopathology. This chapter reviews the recent gene-environment interaction (G x E) and imaging genetics literature with the goal of developing models to bridge these approaches within single imaging gene-environment interaction ({IG} x E) studies, as well as a broader {IG} x E approach to understanding complex behavior. This approach can help neurogenetics models incorporate the environment into biological models. The chapter explores challenges inherent in both G x E and imaging genetics and highlights studies that address these limitations. The chapter examines statistical methods for combining these approaches, and explores plausible biological mechanisms (e.g., epigenetics) through which these conditional mechanisms can be understood. Finally, the chapter discusses the potential contribution that {IG} x E studies can make to understanding complex behavior and psychopathology and developing more personalized and effective prevention and treatment.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Hyde, Luke W. and Bogdan, Ryan and Hariri, Ahmad R.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{dorfman_imaging_2016,
	title = {Imaging Genetics of Antisocial Behavior and Psychopathy},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0017},
	doi = {10.1093/med/9780199920211.003.0017},
	abstract = {Criminal behavior is a costly social problem, making it a crucial subject for scientific investigation. While the risk architecture underlying criminality is complex, psychopathy has emerged as a particularly robust predictor of criminal behavior and recidivism. Psychopathy is a personality disorder characterized by a combination of superficial charm, persistent instrumental antisocial behavior, marked sensation-seeking and impulsivity, blunted empathy and punishment sensitivity, and shallow emotion. While there is a wealth of data suggesting that many of the phenotypical attributes of the disorder are heritable, few specific genetic markers have been identified, and the etiopathophysiology of psychopathy remains largely unknown. This chapter elucidates possible genetic and neurobiological mechanisms for psychopathy and antisocial behavior, clarifies the current limitations of genetics research in this area, and outlines necessary future directions for this field.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Dorfman, Hayley M. and Buckholtz, Joshua W.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{robbins_genetic_2016,
	title = {Genetic Neuroimaging Studies of Basal Ganglia Disorders},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0016},
	doi = {10.1093/med/9780199920211.003.0016},
	abstract = {This chapter discusses new discoveries about the genetic basis of basal ganglia disorders such as Parkinson’s disease and Huntington’s disease, which are necessitating more sophisticated methods for tracking the course and neural characteristics of these diseases, including superior cognitive assessments and multi-modal neuroimaging. Already, a genetic approach to Parkinson’s disease has uncovered new concepts concerning the neural and neurochemical basis of its cognitive sequelae that have been validated with neuroimaging studies. For Huntington’s disease the main issue is in accurately predicting its trajectory in gene positive individuals, using a combination of neuroimaging, behavioral, and clinical methodologies, in association with individual genetic information.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Robbins, Trevor W. and Rowe, James B. and Barker, Roger A.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{andreassen_imaging_2016,
	title = {Imaging Genetics of Bipolar Disorder},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0015},
	doi = {10.1093/med/9780199920211.003.0015},
	abstract = {This chapter presents an updated overview of imaging genetics studies of bipolar disorder. The recent increase in disease risk gene variants has led to a surge in studies analyzing the association with magnetic resonance imaging ({MRI}) brain structures and function in bipolar disorder. Despite a general trend of little consistent results across these studies, some recent converging findings have emerged related to neuronal transmission (i.e. {CACNA}1C). Further, there seem to be more findings of genetic impact on brain activity than anatomical structures in bipolar disorder. The potential reasons for these phenomena, as well as directions for future research, are discussed.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Andreassen, Ole A. and Tesli, Martin},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{fredrikson_imaging_2016,
	title = {Imaging Genetics of Anxiety Disorders},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0014},
	doi = {10.1093/med/9780199920211.003.0014},
	abstract = {This chapter reviews imaging genetics studies in anxiety disorders. Molecular genetic variations affect fear circuit activity during symptomatic challenge in anxiety disorders, with strong support for increased amygdala reactivity and moderate support for decreased prefrontal activity. The mechanisms mediating the effect of allelic variations in genes regulating signaling pathways may involve primary effects in nodes affecting behaviors related to symptomatology later expressed in altered fear network activity and connectivity, or the reverse path with genes initially influencing fear network activity in the brain that subsequently promote anxious behaviors and symptoms. As no longitudinal study exists, data are silent on causality, but it is argued that fear conditioning is a putative mechanism translating the clinical functional and structural associations with genetic variation to situationally elicited anxiety symptomatology.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Fredrikson, Mats},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{sacchet_imaging_2016,
	title = {Imaging Genetics of Depression},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0013},
	doi = {10.1093/med/9780199920211.003.0013},
	abstract = {Given evidence that major depressive disorder ({MDD}) is highly heritable, there has been considerable interest in examining potential associations between genotype and brain function and structure in this disorder. This chapter reviews the current state of neuroimaging genetics and depression, discussing findings concerning associations of single genes (the serotonin transporter gene [5-{HTT}], catechol-O-methyltransferase [{COMT}], and brain-derived neurotrophic factor [{BDNF}]), gene interactions (gene-gene and gene-environment), and polygenic burden with brain structure and function in {MDD}. Growing evidence indicates that specific gene-gene and gene-environment interactions may be associated with aberrant neural structure and function in {MDD}. In this context, investigators have begun to examine interactions between 5-{HTT} and {COMT}, 5-{HTT} and {BDNF}, 5-{HTT} and early life stress, and {BDNF} and early life stress, in addition to polygenic burden, typically assessed in genome-wide association studies. Analyses of these interactions suggest that they have the potential to yield critical insights into the pathophysiology of {MDD}.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Sacchet, Matthew D. and Foland-Ross, Lara C. and Gotlib, Ian H.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{lancaster_imaging_2016,
	title = {Imaging Genetics of Schizophrenia},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0012},
	doi = {10.1093/med/9780199920211.003.0012},
	abstract = {Genome-wide association studies ({GWAS}) of common and rare genetic variants have given unprecedented insight into the genetic architecture of schizophrenia, characterizing it as a highly heritable, polygenic disorder with multifaceted genetic aetiology. Neuroimaging methods provide critical insight into mechanisms of schizophrenia susceptibility by exploring the neural circuits that interpose between genetic risk and the clinical syndrome. This chapter provides an overview of the impact of schizophrenia susceptibility on brain macro/microstructure and alterations of neural circuitry using functional and connectomic approaches. The effects of schizophrenia susceptibility on the brain are explored using an array of genetic risk factors, drawing on neuroimaging studies that probe schizophrenia risk by studying unaffected relatives, common risk polymorphisms, and rare structural variants.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Lancaster, Thomas M. and Doherty, Joanne L. and Linden, David E. and Hall, Jeremy},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{zink_imaging_2016,
	title = {Imaging Genetics of Reward Processing in the Human Brain},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0011},
	doi = {10.1093/med/9780199920211.003.0011},
	abstract = {This chapter examines how genetic variations influence human brain function during reward processing measured with functional magnetic resonance imaging ({fMRI}). Key regional components of the human reward system include the striatum, midbrain nuclei, ventral medial and dorsal prefrontal cortex, orbital frontal cortex, anterior cingulate, amygdala, hippocampus, and thalamus. Reports of human genetic influences on reward system circuitry have placed a strong emphasis on dopamine genetics (e.g., {DAT}, {COMT}, {DRD}2), with fewer non-dopamine genetic variations studied. The genetic influences on reward-related neural activations within the human reward circuitry are highlighted in this chapter, in both healthy and clinical samples. Interpretations of findings are provided in relation to the functionality of particular genetic variations as understood today. The chapter ends with a discussion of potential future directions that may eliminate seemingly conflicting findings in the imaging genetics of reward literature or that may provide more accurate interpretations of the existing data.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Zink, Caroline F.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{stein_genetics_2016,
	title = {Genetics of Brain Structure},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0010},
	doi = {10.1093/med/9780199920211.003.0010},
	abstract = {This chapter details recent advances in identifying the specific genetic variants that alter the development and structure of the human brain. Most aspects of brain structure, as measured through {MRI}, have consistently been shown to be more similar between individuals of closer familial relation, demonstrating a strong genetic basis. The search for specific genetic variants influencing brain structure has led to the identification of rare, highly disruptive mutations that cause drastic effects on the brain structure, as well as common variants that cause more subtle effects. Consortia, including the Enhancing Neuroimaging Genetics through Meta-analysis consortium, have formed to pool together enough data to identify rare genetic influences of large effect or common genetic influences of small effect. Identification of these variants will likely aid in understanding aspects of the mechanism by which changes in genetics may lead to neuropsychiatric disease.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Stein, Jason L. and Hibar, Derrek P. and Thompson, Paul M.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{potkin_identifying_2016,
	title = {Identifying Unanticipated Genes and Mechanisms in Serious Mental Illness: {GWAS}-Based Imaging Genetics Strategies},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0009},
	doi = {10.1093/med/9780199920211.003.0009},
	shorttitle = {Identifying Unanticipated Genes and Mechanisms in Serious Mental Illness},
	abstract = {This chapter, Identifying Unanticipated Genes and Mechanisms in Serious Mental Illness: {GWAS}-Based Imaging Genetics Strategies, points out how the entire genome can be interrogated to identify unanticipated risk genes. This unbiased {GWAS} approach is not constrained by the incomplete understanding of the underlying causes of serious mental illness ({SMI}). New statistical techniques address false positive concerns. There are two major approaches to identifying {SMI} mechanisms. The most common is to compare the allelic {SNP} frequencies between cases and controls, and then use brain imaging to clarify the function of these risk {SNPs}. An alternative approach is to begin with imaging phenotypes that characterize {SMI} brain circuitry and then determine which genes influence this imaging phenotype. Both methods are complementary and can identify risk genes, the net impact of which, using network and pathway analyses, can reveal underlying mechanisms for serious mental illness.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Potkin, Steven G. and van Erp, Theo G. M. and Ling, Shichun and Macciardi, Fabio and Xie, Xiaohui},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{szeszko_imaging_2016,
	title = {Imaging Genetics of Pharmacological Response in Psychiatric Disorders},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0007},
	doi = {10.1093/med/9780199920211.003.0007},
	abstract = {Although pharmacogenetic studies of treatment response may provide information about whether a patient may respond to psychotropic medication, the underlying neurobiological circuitry remains largely unknown. Knowing how a particular polymorphism affects brain structure and/or function could further enhance treatment strategies such as dosing, and/or the use of medications with different pharmacologic properties. This chapter argues that genetics studies investigating treatment response will benefit from the use of brain imaging endophenotypes that could serve to strengthen this link as well as provide novel insights into abnormal neurobiological mechanisms underlying individual differences in treatment response. It reviews existing studies in schizophrenia, depression, bipolar disorder, and attention deficit hyperactivity disorder that have used imaging genetics to investigate treatment response, and suggests that the identification of specific genetics-imaging relationships could increase the variance explained by individual candidate genes and thus may enable treatment to be tailored to patients at the individual level.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Szeszko, Philip R. and Malhotra, Anil K.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{rabl_variability_2016,
	title = {Variability of Antidepressant Drug Response: Contribution of Imaging Genetics Studies},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0006},
	doi = {10.1093/med/9780199920211.003.0006},
	shorttitle = {Variability of Antidepressant Drug Response},
	abstract = {Currently available treatments for major depressive disorder ({MDD}) are insufficient due to moderate and highly variable response rates and frequent adverse drug reactions. While pharmacogenetic research suggests that antidepressant drug response is influenced by common genetic variation in several candidate genes, the same loci have been found to profoundly affect brain regions implicated in the neurobiology of {MDD}. A third line of evidence, pharmacological magnetic resonance imaging, demonstrates that antidepressants impinge on the same brain networks that are implicated in depression. Since antidepressants and genetic variation converge on the same neural intermediate phenotypes, research on antidepressant drug response may benefit from a joint approach investigating interactions between pharmacotherapy and candidate gene variants. This chapter reviews the implications of imaging genetics for the study of variable antidepressant drug response and discusses methodological issues arising from the study of interaction effects between pharmacological challenge and genetic variation in the context of {MDD}.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Rabl, Ulrich and Meyer, Bernhard M. and Pezawas, Lukas},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{van_de_giessen_imaging_2016,
	title = {Imaging of Genetic Variation Impacting Dopamine Transmission Parameters},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0004},
	doi = {10.1093/med/9780199920211.003.0004},
	abstract = {Imaging of genetic variation impacting dopamine transmission parameters The neurotransmitter dopamine is involved in several psychiatric disorders, such as schizophrenia, substance dependence, and Parkinson’s disease. Different genes are involved in the regulation of the dopamine system; therefore, genetic polymorphisms in these genes could affect the functionality of the dopamine system and the susceptibility to disease. This chapter reviews studies that examined the association between genetic polymorphisms and imaging measures of the dopamine system in the brain. These imaging measures assess dopamine synthesis capacity, dopamine receptors, dopamine transporters, and dopamine degradation in vivo in humans using {PET} and {SPECT} imaging. The currently available studies provide interesting leads for gene effects on brain functioning. The field of genetics and imaging of indices of dopaminergic transmission is rapidly advancing. Increasing sample sizes by building (multi-center) databases and widening the focus to epigenetics and genes that are indirectly related to the dopamine system will contribute to successful progress in the field.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {van de Giessen, Elsmarieke and Ghazzaoui, Rassil and Narendran, Raj and Abi-Dargham, Anissa},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{perlman_neuroreceptor_2016,
	title = {Neuroreceptor Imaging of Genetic Variation Impacting the Serotonin Transporter},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0003},
	doi = {10.1093/med/9780199920211.003.0003},
	abstract = {The serotonin reuptake transporter ({SERT}) plays a critical role in regulating serotonin in the human nervous system. This chapter introduces genetic neuroimaging of {SERT} using positron emission tomography ({PET}), an exceptionally powerful tool for in vivo measurement of {SERT} in humans. Several topics are discussed, including the role of the {SERT} in the nervous system, identified variation in {SERT} genes (e.g. {SLC}6A4), strategies and considerations for measuring {SERT} using {PET} ligands (e.g. [11C]{DASB}), general factors that may influence assessment of {SERT} {PET} (e.g. demographics, genetic variation in the {SERT} gene, health conditions), an overview of key findings from studies using {SERT} {PET} to understand psychiatric phenotypes, and future directions for {SERT} {PET} research.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Perlman, Greg and {DeLorenzo}, Christine and Mann, J. John and Parsey, Ramin},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
