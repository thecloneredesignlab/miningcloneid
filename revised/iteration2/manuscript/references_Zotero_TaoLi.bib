@incollection{paul_eisenberg_imaging_2016,
	title = {Imaging Genetics of Williams Syndrome},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0008},
	doi = {10.1093/med/9780199920211.003.0008},
	abstract = {Imaging genetics of Williams syndrome ({WS}; 7q11.23 microdeletion syndrome), a copy number variant ({CNV}) condition in which a small set of known genes are hemideleted with clinically robust cognitive and characterological consequences, encompasses a rapidly maturing body of experimentation responsible for recent insights into the molecular underpinnings of human visuospatial and socio-emotional neural systems. In bypassing some of the specific methodological obstacles facing the neuroimaging genetics field, this corpus not only provides an important complement to neuroimaging investigations derived from genome-wide and candidate gene approaches, but also highlights unique challenges in understanding neurodevelopmental disorders. This chapter explores this multi-faceted work and its progress in delineating the impact of circumscribed, large-effect genetic variation on the structure and function of discrete brain circuits leading to the hallmark neurobehavioral features of {WS}.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Paul Eisenberg, Daniel and Prabhakaran, Ranjani and Berman, Karen F.},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{blasi_imaging_2016,
	title = {Imaging Genetics of Dopamine Synaptic Terminal Activity},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0005},
	doi = {10.1093/med/9780199920211.003.0005},
	abstract = {Dopamine is involved in modulation of several brain functions including high-order cognitive and emotion processing. Dopamine D2 receptors crucially contribute to propagation of dopamine signaling to intra-neuronal cascades, implying molecular adjustments of great relevance for cell physiology. Furthermore, dysregulation of these pathways may induce anomalies in neuronal processes of relevance to the pathophysiology of brain disorders, including schizophrenia. Genetic variation related to D2 receptors modulates several phenotypes ranging from the molecular to the imaging and behavioral levels, whose combined exploration may provide important information on the relationship between gene effects and complex correlates. However, structural variation of gene sequence is likely not the only determinant of the physiology and pathophysiology of the brain. Focusing of the interaction between environmental factors and dopamine-related genetic variation through epigenetic mechanisms may further shed light on the biological determinants of the physiology of the brain and on aspects of its dysregulation in brain disorders.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Blasi, Giuseppe and Bertolino, Alessandro},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{fisher_molecular_2016,
	title = {Molecular Neuroimaging Genetics},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0002},
	doi = {10.1093/med/9780199920211.003.0002},
	abstract = {Molecular neuroimaging is a technique for assaying specific neuromolecular processes, most commonly through the introduction of trace doses of a radioactive molecule targeting a specific protein of interest (e.g. receptor, transporter, enzyme, etc.). Applying molecular neuroimaging within an imaging genetics framework (“molecular neuroimaging genetics”) offers a unique opportunity to inform the understanding of neuromolecular processes that are affected by genetic variation. This chapter presents basic principles of molecular neuroimaging, highlighting both strengths and limitations of this technique in the context of its application in a molecular neuroimaging genetics framework. We consider opportunities for future molecular neuroimaging genetics research that build upon the existing literature including the development of better molecular neuroimaging probes and probes that aim to measure novel molecular processes. Furthermore, we consider opportunities for the development of molecular neuroimaging genetics research in the context of our developing understanding of mechanisms that shape gene expression and regulation.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	author = {Fisher, Patrick M. and Knudsen, Gitte Moos},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
	urldate = {2024-11-24},
	date = {2016-02-01},
}

@incollection{bigos_neuroimaging_2016,
	title = {Neuroimaging Genetics},
	isbn = {978-0-19-992021-1},
	url = {https://doi.org/10.1093/med/9780199920211.003.0001},
	doi = {10.1093/med/9780199920211.003.0001},
	abstract = {Neuroimaging Genetics: Principles and Practices reviews the basic principles of neuroimaging techniques and their application to neuroimaging genetics. Neuroimaging genetics offers an extraordinary tool with which to explore and evaluate the functional impact of brain-relevant genetic variation. Imaging genetics has been used as a tool by researchers in diverse areas of psychiatry, neurology, neuropsychology and cognitive and emotion neuroscience to study the genetic components of brain structure, neurochemistry, and functional differences in living human brain. The work presented in this volume elaborates on examples of the application of imaging genetics to understand neurochemical systems and pathways, explore relationships between genetics and the structural and functional connectivity in human brain, and provide insight into mechanisms of risk for psychiatric and neurologic illness. Imaging genetics studies have identified mechanisms of risk for clinical syndromes, established biologic validation by elucidating mechanisms and pathways that confer genetic risk, and conversely identified genes that contribute to structural and functional variation in brain circuitries. This volume is a comprehensive review of the merging fields of genetics and human neuroscience written for physicians and scientists.},
	pages = {0},
	booktitle = {Neuroimaging Genetics: Principles and Practices},
	publisher = {Oxford University Press},
	editor = {Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R. and Bigos, Kristin L. and Hariri, Ahmad R. and Weinberger, Daniel R.},
