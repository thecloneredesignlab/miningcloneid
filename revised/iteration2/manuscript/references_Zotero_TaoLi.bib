	author = {Parker, Matthew and Chen, Xiang and Bahrami, Armita and Dalton, James and Rusch, Michael and Wu, Gang and Easton, John and Cheung, Nai-Kong and Dyer, Michael and Mardis, Elaine R. and Wilson, Richard K. and Mullighan, Charles and Gilbertson, Richard and Baker, Suzanne J. and Zambetti, Gerard and Ellison, David W. and Downing, James R. and Zhang, Jinghui and {\textbackslash}\$author.{lastName}, {\textbackslash}\$author {firstName}},
	urldate = {2013-09-29},
	date = {2012-12-11},
