	shortjournal = {Nature Medicine},
	author = {Cascone, Tina and William, William N. and Weissferdt, Annikka and Leung, Cheuk H. and Lin, Heather Y. and Pataer, Apar and Godoy, Myrna C. B. and Carter, Brett W. and Federico, Lorenzo and Reuben, Alexandre and Khan, Md Abdul Wadud and Dejima, Hitoshi and Francisco-Cruz, Alejandro and Parra, Edwin R. and Solis, Luisa M. and Fujimoto, Junya and Tran, Hai T. and Kalhor, Neda and Fossella, Frank V. and Mott, Frank E. and Tsao, Anne S. and Blumenschein, George and Le, Xiuning and Zhang, Jianjun and Skoulidis, Ferdinandos and Kurie, Jonathan M. and Altan, Mehmet and Lu, Charles and Glisson, Bonnie S. and Byers, Lauren Averett and Elamin, Yasir Y. and Mehran, Reza J. and Rice, David C. and Walsh, Garrett L. and Hofstetter, Wayne L. and Roth, Jack A. and Antonoff, Mara B. and Kadara, Humam and Haymaker, Cara and Bernatchez, Chantale and Ajami, Nadim J. and Jenq, Robert R. and Sharma, Padmanee and Allison, James P. and Futreal, Andrew and Wargo, Jennifer A. and Wistuba, Ignacio I. and Swisher, Stephen G. and Lee, J. Jack and Gibbons, Don L. and Vaporciyan, Ara A. and Heymach, John V. and Sepesi, Boris},
