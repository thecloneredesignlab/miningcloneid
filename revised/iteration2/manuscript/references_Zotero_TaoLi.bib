@article{foskolou_ribonucleotide_2017,
	title = {Ribonucleotide Reductase Requires Subunit Switching in Hypoxia to Maintain {DNA} Replication},
	volume = {66},
	issn = {1097-4164},
	doi = {10.1016/j.molcel.2017.03.005},
	abstract = {Cells exposed to hypoxia experience replication stress but do not accumulate {DNA} damage, suggesting sustained {DNA} replication. Ribonucleotide reductase ({RNR}) is the only enzyme capable of de novo synthesis of deoxyribonucleotide triphosphates ({dNTPs}). However, oxygen is an essential cofactor for mammalian {RNR} ({RRM}1/{RRM}2 and {RRM}1/{RRM}2B), leading us to question the source of {dNTPs} in hypoxia. Here, we show that the {RRM}1/{RRM}2B enzyme is capable of retaining activity in hypoxia and therefore is favored over {RRM}1/{RRM}2 in order to preserve ongoing replication and avoid the accumulation of {DNA} damage. We found two distinct mechanisms by which {RRM}2B maintains hypoxic activity and identified responsible residues in {RRM}2B. The importance of {RRM}2B in the response to tumor hypoxia is further illustrated by correlation of its expression with a hypoxic signature in patient samples and its roles in tumor growth and radioresistance. Our data provide mechanistic insight into {RNR} biology, highlighting {RRM}2B as a hypoxic-specific, anti-cancer therapeutic target.},
	pages = {206--220.e9},
	number = {2},
	journaltitle = {Molecular Cell},
	shortjournal = {Mol Cell},
	author = {Foskolou, Iosifina P. and Jorgensen, Christian and Leszczynska, Katarzyna B. and Olcina, Monica M. and Tarhonskaya, Hanna and Haisma, Bauke and D'Angiolella, Vincenzo and Myers, William K. and Domene, Carmen and Flashman, Emily and Hammond, Ester M.},
	date = {2017-04-20},
	keywords = {Humans, Time Factors, hypoxia, Female, Oxygen, Animals, Cell Cycle Proteins, {DNA} Replication, replication stress, {DNA} Damage, Xenograft Model Antitumor Assays, Radiation Tolerance, Mice, Inbred {BALB} C, Mice, Nude, {DNA}, Neoplasm, Transfection, Apoptosis, Tumor Burden, Ribonucleotide Reductases, Tumor Suppressor Proteins, Colonic Neoplasms, {HCT}116 Cells, {DNA} damage response, nucleotides, P53, radiosensitivity, Ribonucleoside Diphosphate Reductase, {RNA} Interference, {RNR}, {RRM}2B, Tumor Hypoxia},
