# Figure7/8 only. Portable on the local checkout and HPC; never alters profiles.
_figure78_config_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_figure78_workspace="$(cd -- "${_figure78_config_dir}/../.." && pwd -P)"
if [[ -n "${FIGURE78_WORKSPACE:-}" && "${FIGURE78_WORKSPACE}" != "${_figure78_workspace}" ]]; then
  echo "FIGURE78_WORKSPACE must identify this checkout: ${_figure78_workspace}" >&2
  return 2
fi
export FIGURE78_WORKSPACE="${_figure78_workspace}"
export FIGURE_MODEL_CODE_ROOT="${FIGURE78_WORKSPACE}/Code/vendor/figure78_model"
_figure78_fit="${FIGURE_JOINT_RESULT_ROOT:-${FIGURE78_WORKSPACE}/../../../soft_couping_org/oxygen/results/fit_joint_unified_global_invitro_500seed_all_xxlarge_r442_exact_20260828_145253}"
[[ "${_figure78_fit}" == /* ]] || _figure78_fit="${FIGURE78_WORKSPACE}/${_figure78_fit}"
if [[ -d "${_figure78_fit}" ]]; then
  _figure78_fit="$(cd -- "${_figure78_fit}" && pwd -P)"
fi
export FIGURE_JOINT_RESULT_ROOT="${_figure78_fit}"
export FIGURE78_RSCRIPT="${FIGURE78_RSCRIPT:-${FIGURE78_WORKSPACE}/Code/hpc/figure78_Rscript.sh}"
# Deliberately no FIGURE78_DATA_ROOT default: retained plotting data are not a
# prepared campaign. A manifest worker/submission requires an explicit root.
unset _figure78_config_dir _figure78_workspace _figure78_fit
